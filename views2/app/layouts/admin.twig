{# admin.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=0.8, maximum-scale=1, user-scalable=0">
    <title>{{ title|default(app_name) }}</title>
    <base href="{{base_url}}">
    <link rel="shortcut icon" type="image/x-icon" href="assets/images/branding/favicon.ico">
    <meta name="description" content="{{ meta_description }}">
    <meta name="keywords" content="{{ meta_keywords }}">
    <meta name="author" content="{{ meta_author }}">
    <meta name="robots" content="{{ meta_robots }}">

    <link rel="canonical" href="{{ canonical_url }}">

    {# Optional Open Graph tags for social media sharing #}
    <meta property="og:title" content="{{ page_title ~ ' | ' ~ app_name }}">
    <meta property="og:description" content="{{ meta_description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:site_name" content="{{ app_name }}">

    {% if has_module('Pwa') %}
        <link rel="manifest" href="manifest.json">
        <meta name="theme-color" content="#0077ff">
        <meta name="app-launch-url" content="intent://ilebora/home#Intent;scheme=ilebora;package=com.android.chrome;end">
        <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('service-worker.js')
            .then(() => console.log('Service Worker registered'));
        }
        </script>
    {% endif %}

    <link rel="stylesheet" href="assets/css/main.css?v={{ app_version }}"/>
    <link rel="stylesheet" href="assets/admin/css/admin.bundle.css?v={{ app_version }}">
    <link rel="stylesheet" href="{{cdn_url}}/assets/libs/font-awesome/v5.7.2/css/font-awesome.min.css">
    <link rel="stylesheet" href="{{cdn_url}}/assets/plugins/unsrtd/bootstrap.min.css">
    <link class="scc" rel="stylesheet" type="text/css" href="{{cdn_url}}/assets/libs/font-awesome/v5.7.2/css/all.css">
    {{ renderStyles()|raw }}
    {{ renderInlineStyles()|raw }}
    <script src="assets/js/jquery.js"></script>
    <script src="assets/js/jquery-3.7.1.min.js"></script>
    <script src="assets/js/vendor/crypto-js.min.js"></script>
    <script src="assets/js/app.js?v={{ app_version }}&c={{channelID}}"></script>
    <script src="assets/admin/js/admin.bundle.js?v={{ app_version }}"></script>

    <script>
		const acs = '{{access_permissions}}';
		const acsr = '{{access_role}}';
        const preferences = {{ prefs|default({
            theme: 'dark-mode',
            speech: 'off',
            sound: 'off',
            mode: 'off',
            avatar: 'assets/images/icons/noavatar.jpg'
        }) | json_encode | raw }};
	</script>

    {{ renderSlot('head')|raw }}
    {{ renderStyles()|raw }}
    {{ renderInlineStyles()|raw }}
</head>
{% use 'partials/admin/top_bar.twig' %}
{% use 'partials/admin/sidebar.twig' %}
{% use 'partials/admin/content.twig' %}
{% use 'partials/admin/footer.twig' %}

<body>
    {% include 'partials/overlay.twig' with{
        current_page: current_page
    } %}
    {# Sidebar #}
     {{ block('sidebar') }}

    <div class="main-wrapper">
        {# Top Bar #}
        {{ block('topbar') }}

        {# Main Content #}
        {{ block('container') }}

        {# Footer #}
         {{ block('footer') }}
    </div>
</body>
</html>
