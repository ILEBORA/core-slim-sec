{% block footer %}
<footer class="footer-area animated bounceInUp">

    {% block footer_top %}
        {# Optional area above main footer content (e.g. breadcrumbs, extra nav) #}
        <ul class="footer_menu">
            {{ menus.footer|raw}}

            {% if isLoggedIn() %}
                <li>
                    <a href="javascript:void(0);" data-e-trigger="user.logout">Logout</a>
                </li>
            {% endif %}
        </ul>
    {% endblock %}

    <div class="footer-content">
        {% block footer_content %}
            <p>
                Copyright © {{ "now"|date("Y") }} | {{app.site_name}} | Powered by ILEBORA Tech<br>
                Built on ILEBORA's BoraCore Slim v{{ core_version }}<br>
                ☎ +254113703323
            </p>
        {% endblock %}
    </div>

    {% block footer_bottom %}
        {# Optional area below main footer content (e.g. version info, links) #}
    {% endblock %}
    {{ renderSlot('footer')|raw }}
    
</footer>

{% endblock %}
