{% block sidebar_menu2 %}
    <ul>
        <li><a href="dashboard">Dashboard</a></li>
        <li><a href="manage" class="active">Manage</a></li>
    </ul>

    <h3>Modules</h3>
    <ul>
        {% for key, module in modules %}
            <li>
                <a class="jx" href="{{ module.route }}">
                    {{ module.icon }} {{ module.name }}
                </a>
            </li>
        {% endfor %}
    </ul>
{% endblock %}

{% block content %}

{% include "app/partials/admin/breadcrumb.twig" %}


<div class="categories">
  {% for cat in categories %}
    <div class="card">
      <h3>{{ cat.title }}</h3>
      <a class="jx" href="bo/manage/{{ cat.id }}">Manage {{ cat.title }}</a>
    </div>
  {% endfor %}
</div>
{% endblock %}