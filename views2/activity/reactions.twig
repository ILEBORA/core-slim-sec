{% if reactions.counts is defined %}
    {% for type, count in reactions.counts %}
        <span class="reaction-meta" data-reaction="{{ type }}">
            <span class="icon">
                {% if type == 'like' %}👍{% elseif type == 'love' %}❤️{% elseif type == 'haha' %}😂{% else %}✨{% endif %}
            </span>
            <span class="count">{{ count }}</span>
        </span>
    {% endfor %}
{% endif %}