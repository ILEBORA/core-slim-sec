<div class="activity-item" data-id="{{ item.id }}">
    
    {% include 'activity/header.twig' with { item: item } %}

    <div class="activity-body">
        {{ item.body|raw }}
    </div>

    {% if item.payload.snapshot is defined %}
        {% include 'activity/snapshot.twig' with { snapshot: item.payload.snapshot } %}
    {% endif %}

    <div class="activity-meta">
        <span class="reactions">
            {% include 'activity/reactions.twig' with { reactions: item.reactions } %}
        </span>
        <span class="comments-count">
            {{ item.comments_count }} comments
        </span>
    </div>

    <div class="activity-actions">
        <div class="reaction-box">
            <a href="#" class="reaction-trigger">
                {% if item.reactions.me == 'love' %}❤️{% else %}🤍{% endif %}
            </a>

            <div class="reaction-picker">
                <span class="act-react" data-reaction="like">👍</span>
                <span class="act-react" data-reaction="love">❤️</span>
                <span class="act-react" data-reaction="haha">😂</span>
            </div>
        </div>
        <a href="#" class="act-comment">Comment</a>
    </div>

    <div class="comments"></div>
</div>
