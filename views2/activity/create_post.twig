<div class="bora-post-form">
    <header class="bora-post-header">
        <div class="avatar"></div>
        <span class="username">Me</span>
    </header>

    <textarea id="postContent" placeholder="Write something to post"></textarea>

    <div class="attachments">
        <button data-type="photo">📸 Photo</button>
        <button data-type="video">🎥 Video</button>
        <button data-type="link">🔗 Link</button>
    </div>

    <label class="share-label">Share with</label>
    <select id="postAudience">
        <option value="all">All</option>
        <option value="friends">Friends</option>
        <option value="private">Only Me</option>
    </select>

    <div class="actions">
        <button class="cancel-btn" data-action="cancel">Cancel</button>
        <button class="post-btn" data-action="post">Post</button>
    </div>
</div>