<div id="user-input" class="upload">
    <input type="file" id="upload-input" name="{{ elem_key }}" accept="{{ accept|default('*/*') }}">
    <div class="upload-preview"></div>
</div>

<button id="send-btn" class="btn">Upload</button>

<script>
ILEBORA.use('assets/js/jquery.js', function() {
    var $input = $('#upload-input');
    var $preview = $('#user-input.upload .upload-preview');

    // show file name / preview
    $input.on('change', function() {
        $preview.empty();
        var file = this.files[0];
        if (!file) return;

        // Show filename
        $('<p>').text("Selected: " + file.name).appendTo($preview);

        // If image, show preview thumbnail
        if (file.type.match(/^image\//)) {
            var reader = new FileReader();
            reader.onload = function(e) {
                $('<img>').attr('src', e.target.result)
                          .css({maxWidth:'150px', marginTop:'10px'})
                          .appendTo($preview);
            };
            reader.readAsDataURL(file);
        }
    });

    // submit on button click
    $('#send-btn').off('click.upload').on('click.upload', function(e) {
        e.preventDefault();
        var file = $input[0].files[0];
        if (!file) {
            alert("Please select a file first.");
            return;
        }

        console.log(file);

        // send file using FormData
        var formData = new FormData();
        formData.append('file', file);
        for (var pair of formData.entries()) {
            console.log(pair[0]+ ': ' + pair[1]);
        }
        $.ajax({
            url: 'api/modules/curiosity/uploads/file',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function(response) {
                // Assume API returns { url: "...uploaded path..." }
                var fileUrl = response.url || '';
                manager.handleUserInput(fileUrl);
            },
            error: function(err) {
                alert("Upload failed.");
                console.error(err);
            }
        });
    });
});
</script>
