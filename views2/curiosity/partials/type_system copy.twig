{# type_system.twig #}
<div class="curiosity-system-message">
    <span class="system-loader">Processing<span class="dots">...</span></span>
</div>

<style>
.curiosity-system-message {
    font-style: italic;
    color: #666;
    margin: 10px 0;
}

.system-loader .dots::after {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-left: 2px;
    background: #666;
    border-radius: 50%;
    animation: blinkDots 1s infinite steps(3, start);
}

@keyframes blinkDots {
    0%, 20% { content: ''; }
    40% { content: '.'; }
    60% { content: '..'; }
    80%, 100% { content: '...'; }
}
</style>

<script>
(function animateDots() {
    const el = document.querySelector('.system-loader .dots');
    if (!el) return;
    let count = 0;
    setInterval(() => {
        count = (count + 1) % 4;
        el.textContent = '.'.repeat(count);
    }, 500);
})();
</script>

<button id="send-btn" class="btn">Send</button>