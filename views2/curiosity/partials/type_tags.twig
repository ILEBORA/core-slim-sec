<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<div id="user-input" class="tags-input">
    <select id="tags-select" multiple="multiple" style="width:100%;">
        {# Optional: preload tags passed in `options` #}
        {% if options is defined %}
            {% for opt in options %}
                {% if opt is iterable %}
                    <option value="{{ opt.value is defined ? opt.value : (opt.id is defined ? opt.id : loop.index) }}">
                        {{ opt.label is defined ? opt.label : (opt.name is defined ? opt.name : opt|first) }}
                    </option>
                {% else %}
                    <option value="{{ opt|lower }}">{{ opt }}</option>
                {% endif %}
            {% endfor %}
        {% endif %}
    </select>
</div>

<button id="send-btn" class="btn">Submit</button>

<script>
ILEBORA.use('https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js', function() {
    $(function() {
        $('#tags-select').select2({
            placeholder: "Select or add interests",
            tags: true,                 // allow new tags
            tokenSeparators: [',', ' '],
            allowClear: true,
            ajax: {
                url: 'api/modules/curiosity/interests',
                dataType: 'json',
                delay: 250,
                processResults: function (data) {
                    if (data.results) {
                        return data;
                    }
                    // Otherwise map it manually
                    return {
                        results: data.map(function (item) {
                            return { id: item.id, text: item.text }; // <- use `id`, not `pid`
                        })
                    };
                },
                cache: true
            }
        });

        $('#send-btn').on('click', function(e) {
            e.preventDefault();
            var values = $('#tags-select').val() || []; // array of selected/added tags

            // pass array to manager
            manager.handleUserInput(values);
        });
    });
});
</script>
