<div class="system-input-wrapper">
    <div class="system-status">
        <span class="loader"></span>
        <span class="status-text">{{ status_text|default('Processing...') }}</span>
    </div>
</div>

<style>
.system-input-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background-color: #f7f7f7;
    border-radius: 6px;
    border: 1px solid #ddd;
    font-family: sans-serif;
}

.system-status {
    display: flex;
    align-items: center;
    gap: 8px;
}

.loader {
    width: 16px;
    height: 16px;
    border: 3px solid #ccc;
    border-top-color: #007bff;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    0% { transform: rotate(0deg);}
    100% { transform: rotate(360deg);}
}

.status-text {
    font-size: 14px;
    color: #555;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function(){
    // Optional: simulate a background process or bind to your JS
    const statusEl = document.querySelector('.system-status .status-text');

    // Example: change text after 2 seconds
    setTimeout(() => {
        statusEl.textContent = '{{ done_text|default("Done!") }}';
        document.querySelector('.loader').style.display = 'none';
    }, 2000);
});
</script>
