<style>
#ios-add-hint {
    position: fixed;
    bottom: -150px;
    left: 50%;
    transform: translateX(-50%);
    width: 92%;
    background: rgba(255,255,255,0.96);
    border-radius: 18px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.25);
    text-align: center;
    font-size: 15px;
    color: #222;
    padding: 14px 16px;
    line-height: 1.4;
    z-index: 99999;
    backdrop-filter: blur(6px);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    opacity: 0;
    pointer-events: none;
    transition: all 0.6s cubic-bezier(0.25, 1, 0.5, 1);
}

#ios-add-hint.visible {
    bottom: 15px;
    opacity: 1;
    pointer-events: auto;
}

#ios-add-hint button {
    margin-top: 10px;
    background: #0a84ff;
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 6px 14px;
    font-size: 14px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    cursor: pointer;
    transition: background 0.3s;
}

#ios-add-hint button:hover {
    background: #006ae0;
}
</style>

<div id="ios-add-hint">
    <div style="margin-bottom:6px;font-weight:600;">
        📱 Add <span style="color:#0a84ff;">IleBora</span> to your Home Screen
    </div>
    <div style="font-size:14px;">
        Tap <span style="font-weight:600;">Share</span> → <span style="font-weight:600;">Add to Home Screen</span> to install the app.
    </div>
    <button id="ios-hint-dismiss">Got it</button>
</div>

<script>
(function(){
    const hint = document.getElementById('ios-add-hint');
    if(!hint) return;

    const dismissed = localStorage.getItem('ios_hint_dismissed') === '1';
    const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || navigator.standalone;

    if(isIOS && !isStandalone && !dismissed){
        setTimeout(() => hint.classList.add('visible'), 800);
    }

    document.getElementById('ios-hint-dismiss')?.addEventListener('click', () => {
        localStorage.setItem('ios_hint_dismissed', '1');
        hint.classList.remove('visible');
        setTimeout(() => hint.style.display = 'none', 500);
    });

    window.addEventListener('appinstalled', () => {
        localStorage.setItem('ios_hint_dismissed', '1');
        hint.classList.remove('visible');
    });
})();
</script>
