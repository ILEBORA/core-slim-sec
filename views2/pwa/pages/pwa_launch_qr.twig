<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IleBora App Launcher</title>
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0057ff">
  <style>
    body {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: 100vh;
      background: linear-gradient(145deg, #e9f0ff, #ffffff);
      font-family: system-ui, sans-serif;
      text-align: center;
      color: #222;
      margin: 0;
      padding: 0 15px;
    }
    h1 {
      font-size: 1.5rem;
      color: #0057ff;
      margin-bottom: 0.5em;
    }
    p {
      font-size: 1rem;
      margin-bottom: 1em;
      color: #555;
    }
    canvas {
      margin: 1em 0;
      padding: 10px;
      background: white;
      border-radius: 12px;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
    }
    button {
      background: #0057ff;
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 8px;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.3s;
    }
    button:hover {
      background: #0040cc;
    }
    footer {
      margin-top: 2em;
      font-size: 0.85rem;
      color: #888;
    }
  </style>
</head>
<body>
  <h1>Open IleBora App</h1>
  <p>Scan this QR code to launch the IleBora App instantly.</p>
  <canvas id="qr"></canvas>
  <button id="openAppBtn">Open App Now</button>
  <footer>© 2025 IleBora Technologies</footer>

  <script src="https://cdn.jsdelivr.net/npm/qrious/dist/qrious.min.js"></script>
  <script>
    const appLink = "ilebora://home";
    const qr = new QRious({
      element: document.getElementById('qr'),
      value: appLink,
      size: 200,
      background: 'white',
      foreground: '#0057ff',
    });

    // Attempt auto-open after delay
    setTimeout(() => {
      window.location.href = appLink;
      // Fallback to web if not installed
      setTimeout(() => {
        window.location.href = "https://ilebora.co.ke/?utm_source=qrlauncher";
      }, 2000);
    }, 1000);

    document.getElementById('openAppBtn').onclick = () => {
      window.location.href = appLink;
      setTimeout(() => {
        window.location.href = "https://ilebora.co.ke/?utm_source=qrmanual";
      }, 2000);
    };
  </script>
</body>
</html>
