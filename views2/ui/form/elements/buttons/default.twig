<div class="{{ wrapper }} button-wrapper" style="width:100%;">
    <div align="center">
        <div id="form_status"> </div>
        <button 
            id="{{ parseID }}{{ name }}" 
            class="{{ itemClass }}"
            {{ onclick }} 
            {{ extras }} 
            >
            <span class="btn_text">{{ placeholder }}</span>
            <span class="btn_loading"></span>                                    
        </button>
    </div>
</div>