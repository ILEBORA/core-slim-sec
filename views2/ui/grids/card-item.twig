<div class="grid-card grid-item"
     data-id="{{ item.id|default(loop.index) }}">

  <div class="card-header">
    <h3>{{ item.title|default(attribute(item, config.title_field|default('name'))) }}</h3>
  </div>

  <div class="card-body">
    {% for col in config.columns %}
      <div class="card-row">
        <span class="label">{{ col|capitalize }}:</span>
        <span class="value">{{ attribute(item, col)|raw }}</span>
      </div>
    {% endfor %}
  </div>

</div>
