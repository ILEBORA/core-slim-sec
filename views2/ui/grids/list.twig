{# Base List Grid View (grids/list.twig) #}
<div class="grid-wrapper" data-grid-type="list" data-grid-id="{{ config.id|default('') }}" data-grid-unique="{{ config.unique }}">
  <ul class="grid-list {{ config.class|default('') }}">
    {% block grid_body %}
      {% for item in data.data %}
        <li class="grid-item" data-id="{{ item.id|default(loop.index) }}">
          {% block grid_item %}
            <div class="item-title">
              {{ item.title|default(attribute(item, config.title_field|default('name'))) }}
            </div>
            <div class="item-meta">
              {% for col in config.columns %}
                <span class="meta">
                  <strong>{{ col|capitalize }}:</strong> {{ attribute(item, col)|raw }}
                </span>
              {% endfor %}
            </div>
          {% endblock %}
        </li>
      {% else %}
        <li class="grid-empty">No records found</li>
      {% endfor %}
    {% endblock %}
  </ul>

  {% block grid_footer %}
    <div class="grid-footer">
      {% block grid_pagination %}
        {% include "grids/partials/pagination.twig"  with {config:config, gridType:'list'} %}
      {% endblock %}
    </div>
  {% endblock %}
</div>

<style>
.grid-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.grid-item {
  border-bottom: 1px solid #eee;
  padding: 1rem;
}
.grid-item:last-child {
  border-bottom: none;
}
.item-title {
  font-weight: 600;
  font-size: 1rem;
}
.item-meta {
  color: #555;
  font-size: .9rem;
  margin-top: .25rem;
}
.meta {
  margin-right: 1rem;
}
.grid-empty {
  padding: 2rem;
  text-align: center;
  color: #888;
}
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
<script>

</script>
