<div class="inf_block">
    <div class="inf_title">Personal Details 
        <a title="Edit" class="edit_link " onclick="return false;" style="display:none;"></a>

    </div>
    <br clear="left">
    <div class="inf_cont shdw" align="center">
        <div class="image_box">  
            <div id="" class="roundedge" style="width:100%;position:relative;z-index:7; overflow:hidden;">
                <a id="" title="Edit" class="avtrBox edit_link r-t" data-itm="{{ id }}" data-id="user" data-prev="{{avatar|raw}}" onclick="return mPGs.changeAvatar(this);">edit </a>
                <img class="userAvatar{{ id }} lazy" style="width:100%;height:250px;" src="assets/images/icons/noavatar.png" data-src="{{avatar|raw}}">
            </div>   
        </div>
        
        <div class="roundedge info_box">              
            <table id="spm" width="100%" border="0" cellpadding="0" cellspacing="0">

                <tbody><tr>
                    <td align="right" width="20%" valign="middle"><span>Name:</span></td>
                    <td><span id="lable">{{ name }}</span></td>
                    <td width="25"></td>
                </tr>
                <tr>
                    <td align="right" valign="middle"><span>Email:</span></td>
                    <td><span id="lable">{{ email }}</span></td>
                    <td width="25"></td>
                </tr>
                <tr>
                    <td align="right" valign="middle"><span>Phone:</span></td>
                    <td><span id="lable">{{ phone }}</span></td>
                    <td width="25"></td>
                </tr>
                <tr style="display:none;">
                    <td align="right" valign="middle"><span>Gender:</span></td>
                    <td><span id="lable">{{ gender }}</span></td>
                    <td width="25"></td>
                </tr>
            </tbody></table>
        </div>
        <br clear="all">    
    </div>
    
</div>