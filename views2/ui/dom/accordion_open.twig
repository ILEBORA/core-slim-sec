<li id="item{{ id }}" class="{{ class }}" data-level="{{ data_level }}" >
    
    <span class="toggle inactive">
        <span style="float:right;">
            {{ tools|raw }}
        </span>
        {{ main|raw }}
    </span>
    <ul id="{{ ulid }}" class="inner {{ ulclass }} {{ data_level }}" style="display:block" data-level="{{ data_level }}">
        {{ inner|raw }}
    </ul>
</li>