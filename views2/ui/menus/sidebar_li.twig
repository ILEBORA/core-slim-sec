<li id="mnuitm_{{ lbl }}" data-pos="{{ i }}" href="{{ href }}" {{ onclick }} class="itemWithEdd features-item {{ name }} mnu mnu_{{ lable }} {{ active }}">
    <i class="{{ icon }} features-item-icon inbox-icon"><span class="status"></span></i>
    <span class="features-item-text">{{ text }}</span>
    <span class="inbox-number">{{ liveupdts }}</span>
    <span class="tooltip">{{ text }}</span>

    <i id="menu_loading_{{ lable }}" class="menu_loading"></i>   
    <span>{{ tools }}</span>     
</li>