<!--Count item widget -->
@if( $statusmode != "" ) 
@set($statustitle="<h2 class='mode_text' >Widget flagged: $statusmode</h2>")
@set($itemtitle="Item not visible without permissions.")
@else
@set($statustitle="")
@set($itemtitle="")
@endif
<div class="col-xl-2 col-md-4 col-6 widget_container widget_mode @($statusmode) widget_mode_@($id)" data-typ="@($class)" pointer fnl="@($link)" title="@($itemtitle)">
    <span class="widget_tools">@($tools) </span>
    <div class="wrapper count-title d-flex w-full">
    
    <div class="name">
        @($statustitle)
        <strong class="text-uppercase">@($title)</strong>
        <span>@($desc)</span>
    </div>
    </div>
</div>