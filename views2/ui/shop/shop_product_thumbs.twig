<div class="incart{{ id }} gridViewItem {{ active }} {{ activeclss }} 
        wow fadeInUp animated" data-wow-delay="0.{{ i }}s" style="visibility: visible;-webkit-animation-delay: 0.{{ i }}s; -moz-animation-delay: 0.{{ i }}s; animation-delay: 0.{{ i }}s;"
>
       <span class="tools-r time">
         	{{ tools }} 
			<span lvui="cart_count_{{ id }}" class="ct{{ id }} cart_count round">{{ qty }}</span>
			<abbr class="badge" style="">{{ itemscount }}</abbr>
        </span>
        
        <a href="javascript:void(0)" onclick="{{ link }}">
            <img class="prod {{ itemclass }}Avatar{{ id }} albart lazyload" data-ref="work" src="{{ imageThumb }}" data-src="{{ image }}">
            
        </a>

        <span class="price_tag"><abbr>{{ price }}</abbr></span>

        <div class="det">
                <div id="quote">
                    <div style="position:absolute;top:-23px;right:2px;;">
                            <button data-id="{{ id }}" class="btn small btn-info cartbtn rmvcbtn rmvc{{ id }}" onclick="event.preventDefault();shoppingCart.removeItem(this)" ><i class="fa fa-minus" aria-hidden="true"></i></button>

                            <button" data-id="{{ id }}" class="btn small btn-info cartbtn addc{{ id }}" onclick="event.preventDefault();shoppingCart.addToCart(this)">Add <i class="fa fa-plus" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="product_name" align="center">{{ title }}  | {{ specs }}</div>
        </div>
</div>