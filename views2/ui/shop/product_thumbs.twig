@if( $quantity < 1 ) 
@set($showMinus="none")
@set($qty="")
@else
@set($activeclss="active_item")
@set($qty=$quantity)
@endif

<div class="incart{{ id }} gridViewItem {{ active }} {{ activeclss }}">
        <span class="tools-r time">
         	{{ tools }} 
			<span lvui="cart_count_{{ id }}" class="ct{{ id }} cart_count round">{{ qty }}</span>
			<abbr class="badge" style="">{{ itemscount }}</abbr>
        </span>
        
        <a href="javascript:void(0)" onclick="mPGs.klassPopup('Products','details',{{ id }},'details')">
            <img class="prod {{ itemclass }}Avatar{{ id }} albart lazyload" data-ref="work" src="assets/images/branding/placeholder.png" data-src="{{ image }}">
        </a>

        <span class="price_tag"><abbr>{{ price }}</abbr></span>

        <div class="det">
                <div id="quote">
                    <div style="position:absolute;top:-23px;right:2px;;">
                            <button style="display:{{ showMinus }};" data-id="{{ id }}" class="btn small btn-info cartbtn rmvc{{ id }}" onclick="event.preventDefault();shoppingCart.removeItem(this)" ><i class="fa fa-minus" aria-hidden="true"></i></button>

                            <button" data-id="{{ id }}" class="btn small btn-info cartbtn addc{{ id }}" onclick="event.preventDefault();shoppingCart.addToCart(this)">Add <i class="fa fa-plus" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="product_name" align="center">{{ title }}  | {{ specs }}</div>
        </div>
</div>