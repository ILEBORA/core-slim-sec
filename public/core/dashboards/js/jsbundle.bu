);

/* --------------------------------------------------
 | Resources
 * ------------------------------------------------- */

$pipeline->register('dashboards.resources', [
    'file'      => 'plugins/dashboards.resources.js',
    'type'      => 'plugin',
    'priority'  => 10,
    'preload'   => true,
    'routes' => [
        // 'portal/dashboards',
        // 'portal/dashboards/*',
        'bo/dashboards',
        'bo/dashboards/*',
    ],
]);

