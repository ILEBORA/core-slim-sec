<?php
require __DIR__ . '/../../../../../../../vendor/autoload.php';

EnvLoader::load(__DIR__ . '/../../../../../../../', 'wahenga');

use BoraSlim\Core\Assets\AssetPipelineJs;

$pipeline = new AssetPipelineJs('inbox', __DIR__);

/* GLOBAL */
$pipeline->register('inbox.actions', [
    'file'     => 'plugins/inbox.actions.js',
    'type'     => 'plugin',
    'priority' => 99,
    'preload' => true
]);

/* ==================================================
   HELPERS
================================================== */

$pipeline->register('inbox.helpers', [
    'file'     => 'utils/InboxHelpers.js',
    'type'     => 'lib',
    'priority' => 100,
    'preload'  => true,
]);

$pipeline->register('inbox.tests', [
    'file'     => 'utils/InboxTests.js',
    'type'     => 'lib',
    'priority' => 101,
    'requires' => ['inbox.helpers'],
]);

/* ==================================================
   COMPOSER
================================================== */

$pipeline->register('inbox.composer', [
    'file'     => 'composer/inbox.composer.js',
    'type'     => 'plugin',
    'priority' => 110,
    'requires' => ['inbox.helpers'],
]);

/* ==================================================
   UI LAYER
================================================== */

$pipeline->register('inbox.ui', [
