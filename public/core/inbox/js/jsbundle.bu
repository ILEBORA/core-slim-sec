<?php

require __DIR__ . '/../../../../../../../vendor/autoload.php';

EnvLoader::load(
    __DIR__ . '/../../../../../../../',
    'wahenga'
);

use BoraSlim\Core\Assets\AssetPipelineJs;

$pipeline = new AssetPipelineJs(
    'inbox',
    __DIR__
);

/* ---------- Global ---------- */

$pipeline->register('inbox.actions', [
    'file'      => 'plugins/inbox.actions.js',
    'type'      => 'plugin',
    'priority'  => 10,
    'preload'   => true
]);

/* ---------- Core ---------- */

$pipeline->register('inbox.helpers', [
    'file'             => 'utils/InboxHelpers.js',
    'type'             => 'lib',
    'workspaceService' => true
]);

$pipeline->register('inbox.tests', [
    'file'             => 'utils/InboxTests.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'inbox.helpers'
    ]
]);

$pipeline->register('inbox.composer', [
    'file'             => 'composer/inbox.composer.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'inbox.helpers'
    ]
]);

$pipeline->register('inbox.ui', [
    'file'             => 'controllers/InboxUI.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'inbox.composer'
    ]
]);

$pipeline->register('inbox.typing', [
    'file'             => 'controllers/InboxTyping.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'inbox.ui'
    ]
]);

$pipeline->register('inbox.threadloader', [
    'file'             => 'controllers/InboxThreadLoader.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'inbox.ui'
        // 'inbox.typing'
    ]
]);

$pipeline->register('inbox.presence', [
    'file'             => 'controllers/InboxPresence.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'inbox.ui'
    ]
]);

$pipeline->register('inbox.notifications', [
    'file'             => 'controllers/InboxNotifications.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'inbox.ui'
    ]
]);

$pipeline->register('inbox.realtime', [
    'file'             => 'controllers/InboxRealtime.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'inbox.ui'
    ]
]);

$pipeline->register('inbox.api', [
    'file'             => 'controllers/InboxAPI.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'inbox.helpers',
        'inbox.threadloader',
        'inbox.presence'
    ]
]);

/* ---------- Plugins ---------- */

$pipeline->register('inbox.ui.interactions', [
    'file' => 'plugins/inbox.ui.interactions.js',
    'type' => 'plugin',
]);

$pipeline->register('inbox.breadcrumbs', [
    'file' => 'plugins/inbox.breadcrumbs.js',
    'type' => 'plugin',
]);


/* ---------- Workspace ---------- */

$pipeline->register('inbox.workspace', [

    'file'      => 'plugins/inbox.workspace.js',

    'type'      => 'plugin',

    'workspace' => true,

    'priority'  => 200,

    'requires' => [
        'inbox.helpers',
        'inbox.ui',

        'inbox.typing',
        'inbox.threadloader',

        'inbox.notifications',
        'inbox.realtime',

        'inbox.api'
    ],

    'routes' => [
        'portal/inbox',
        'portal/inbox/thread/{thread}'
    ]
]);

$pipeline
    ->setDebug(true)
    ->compile();