<?php

require __DIR__ . '/../../../../../../../vendor/autoload.php';

EnvLoader::load(
    __DIR__ . '/../../../../../../../',
    'wahenga'
);

use BoraSlim\Core\Assets\AssetPipelineJs;

$pipeline = new AssetPipelineJs(
    'app',
    __DIR__,
    'core'
);

/* ---------- Global ---------- */
$pipeline->register('app.actions', [
    'file' => 'plugins/app.actions.js',
    'type' => 'plugin',
    'priority'  => 10,
    // 'requires' => [
        
    // ]
]);

$pipeline
    ->setDebug(true)
    ->compile();