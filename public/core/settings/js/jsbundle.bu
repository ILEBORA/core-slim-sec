<?php
require __DIR__ . '/../../../../../../../vendor/autoload.php';

EnvLoader::load(__DIR__ . '/../../../../../../../', 'wahenga');

use BoraSlim\Core\Assets\AssetPipelineJs;

$origin = $GLOBALS['__CURRENT_MODULE_ORIGIN__'] ?? 'core';

$pipeline = new AssetPipelineJs('settings', __DIR__, $origin);

/* ==================================================
   LIBS (FOUNDATION)
================================================== */

$pipeline->register('settings.plugin', [
    'file'     => 'plugins/settings.plugin.js',
    'type'     => 'lib',
    'priority' => 100,
    'requires' => [],
    
    'routes' => [
        'portal/profile',
        'portal/profile/*',
        'bo/users',
        'bo/users/*',
        'bo/settings',
        'bo/settings/*',
    ],
]);


/* ==================================================
   PLUGINS (UI BEHAVIOUR)
================================================== */

