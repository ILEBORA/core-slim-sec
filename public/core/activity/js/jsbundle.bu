<?php
require __DIR__ . '/../../../../../../../vendor/autoload.php';

EnvLoader::load(__DIR__ . '/../../../../../../../', 'wahenga');

use BoraSlim\Core\Assets\AssetPipelineJs;

$pipeline = new AssetPipelineJs('activity', __DIR__, 'core');

/* ==================================================
   SERVICES
================================================== */

$pipeline->register('activity.utils', [
    'file'     => 'services/activity.utils.js',
    'type'     => 'service',
    'priority' => 100,
]);

$pipeline->register('activity.feed.service', [
    'file'     => 'services/activity.feed.js',
    'type'     => 'service',
    'priority' => 120,
    'requires' => ['runtime'],
]);

/* ==================================================
   PLUGINS
================================================== */

$pipeline->register('activity.composer', [
    'file'     => 'plugins/activity.composer.js',
    'type'     => 'plugin',
    'priority' => 200,
    'requires' => ['runtime', 'activity.utils'],
]);

$pipeline->register('activity.feed.ui', [
    'file'     => 'plugins/activity.feed.ui.js',
    'type'     => 'plugin',
    'priority' => 210,
    'requires' => ['runtime', 'activity.feed.service'],
]);

$pipeline->register('activity.actions', [
    'file'     => 'plugins/activity.actions.js',
    'type'     => 'plugin',
    'priority' => 220,
    'requires' => ['runtime', 'activity.feed.ui'],
]);

$pipeline->register('activity.thread', [
    'file'     => 'plugins/activity.thread.js',
    'type'     => 'plugin',
    'priority' => 230,
    'requires' => ['runtime'],
]);

$pipeline->register('activity.breadcrumbs', [
    'file'     => 'plugins/activity.breadcrumbs.js',
    'type'     => 'plugin',
    'priority' => 231,
    'requires' => ['runtime'],
]);

$pipeline->register('activity.stories', [
    'file'     => 'plugins/activity.stories.js',
    'type'     => 'plugin',
    'priority' => 240,
    'requires' => ['runtime'],
]);

$pipeline->register('activity.story.composer', [
    'file'     => 'plugins/activity.story.composer.js',
    'type'     => 'plugin',
    'priority' => 241,
    'requires' => ['runtime'],
]);

/* ==================================================
   COMPILE
================================================== */

$pipeline->compile();