<?php

require __DIR__ . '/../../../../../../../vendor/autoload.php';

EnvLoader::load(
    __DIR__ . '/../../../../../../../',
    'wahenga'
);

use BoraSlim\Core\Assets\AssetPipelineJs;

$pipeline = new AssetPipelineJs(
    'activity',
    __DIR__,
    'core'
);

/* ---------- Global ---------- */
$pipeline->register('activity.actions', [
    'file' => 'plugins/activity.actions.js',
    'type' => 'plugin',
    'priority'  => 10,
    'faces'     => ['client']
    // 'requires' => [
        
    // ]
]);

/* ---------- Core ---------- */

$pipeline->register('activity.utils', [
    'file'             => 'services/activity.utils.js',
    'type'             => 'lib',
    'workspaceService' => true,
    'routes' => [
        'portal/activity',
        'portal/activity/*'
    ],
]);

$pipeline->register('activity.feed', [
    'file'             => 'services/activity.feed.js',
    'type'             => 'lib',
    'workspaceService' => true,
    'routes' => [
        'portal/activity',
        'portal/activity/*'
    ],
    'requires' => [
        'activity.utils'
    ]
]);

/* ---------- Plugins ---------- */

$pipeline->register('activity.composer', [
    'file' => 'plugins/activity.composer.js',
    'type' => 'plugin',
    'routes' => [
        'portal/activity',
        'portal/activity/*'
    ],
    'requires' => [
        'activity.utils'
    ]
]);

$pipeline->register('timeline.controller', [
    'file' => 'plugins/timeline/controller.js',
    'type' => 'plugin',
    'routes' => [
        'portal/activity',
        'portal/activity/*'
    ],
    'requires' => [
      
    ]
]);


$pipeline->register('activity.thread', [
    'file' => 'plugins/activity.thread.js',
    'type' => 'plugin',
    'routes' => [
        'portal/activity',
        'portal/activity/*'
    ],
]);

$pipeline->register('activity.breadcrumbs', [
    'file' => 'plugins/activity.breadcrumbs.js',
    'type' => 'plugin',
    'routes' => [
        'portal/activity',
        'portal/activity/{id}'
    ],

]);

/* ---------- Stories ---------- */

$pipeline->register('activity.stories.feed', [
    'file' => 'plugins/stories/feed.js',
    'type' => 'plugin',
    'routes' => [
        'portal/activity',
        'portal/activity/*'
    ],
]);

$pipeline->register('activity.stories.viewer', [
    'file' => 'plugins/stories/viewer.js',
    'type' => 'plugin',
    'routes' => [
        'portal/activity',
        'portal/activity/*'
    ],
    'requires' => [
        'activity.stories.feed'
    ]
]);

$pipeline->register('activity.stories.actions', [
    'file' => 'plugins/stories/actions.js',
    'type' => 'plugin',
    'routes' => [
        'portal/activity',
        'portal/activity/*'
    ],
    'requires' => [
        'activity.stories.viewer'
    ]
]);

$pipeline->register('activity.stories.composer', [
    'file' => 'plugins/stories/composer.js',
    'type' => 'plugin',
    'routes' => [
        'portal/activity',
        'portal/activity/*'
    ],
    'requires' => [
        'activity.stories.actions'
    ]
]);

$pipeline->register('activity.stories.state', [
    'file' => 'plugins/stories/state.js',
    'type' => 'plugin',
    'routes' => [
        'portal/activity',
        'portal/activity/*'
    ],
    'requires' => [
        'activity.stories.viewer'
    ]
]);

/* ---------- Workspace ---------- */

$pipeline->register('activity.workspace', [

    'file'      => 'plugins/activity.workspace.js',

    'type'      => 'plugin',

    'workspace' => true,

    'priority'  => 200,

    'routes' => [
        'portal/activity',
        'portal/activity/{id}'
    ],

    'requires' => [

        'activity.composer',

        'activity.actions',

        'activity.thread',
        'activity.breadcrumbs',

        'activity.stories.feed',
        'activity.stories.viewer',
        'activity.stories.actions',
        'activity.stories.composer',
        'activity.stories.state'
    ]
]);

$pipeline
    ->setDebug(true)
    ->compile();