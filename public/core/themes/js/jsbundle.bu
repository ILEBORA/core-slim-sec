$pipeline = new AssetPipelineJs('themes', __DIR__, $origin);

/* ==================================================
   LIBS (FOUNDATION)
================================================== */

$pipeline->register('themes.plugin', [
    'file'     => 'plugins/themes.plugin.js',
    'type'     => 'plugin',
    'priority' => 100,
    'requires' => [],
    
    'routes' => [
          // 'portal/themes',
          // 'portal/themes/*',
          'bo/themes',
          'bo/themes/*',
    ],
]);


