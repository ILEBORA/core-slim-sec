<?php
require __DIR__ . '/../../../../../../../vendor/autoload.php';

EnvLoader::load(__DIR__ . '/../../../../../../../', 'wahenga');

use BoraSlim\Core\Assets\AssetPipelineJs;

$pipeline = new AssetPipelineJs('comm', __DIR__);

$pipeline->register('comm.plugin', [
    'file'     => 'plugins/comm.plugin.js',
    'type'     => 'plugin',
    'priority' => 101,
    'requires' => [
    ],
    'routes' => [
        'portal/comm',
        'portal/comm/*',
        'bo/comm',
        'bo/comm/*',
    ],
]);

/* ==================================================
   COMPILE → manifest
================================================== */

