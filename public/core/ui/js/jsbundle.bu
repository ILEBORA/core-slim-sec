<?php
require __DIR__ . '/../../../../../../../vendor/autoload.php';

EnvLoader::load(__DIR__ . '/../../../../../../../', 'wahenga');

use BoraSlim\Core\Assets\AssetPipelineJs;

$origin = $GLOBALS['__CURRENT_MODULE_ORIGIN__'] ?? 'core';

$pipeline = new AssetPipelineJs('ui', __DIR__, $origin);

/* ==================================================
   LIBS (FOUNDATION)
================================================== */

$pipeline->register('ui.core', [
    'file'     => 'script.js',
    'type'     => 'lib',
    'priority' => 100,
    'requires' => ['runtime'],
]);

/* ==================================================
   SERVICES (HOOK SYSTEM)
================================================== */

$pipeline->register('ui.hooks', [
    'file'     => 'hooks.js',
    'type'     => 'lib',
    'priority' => 110,
    'requires' => ['runtime'],
]);

/* ==================================================
   PLUGINS (UI BEHAVIOUR)
================================================== */

$pipeline->register('ui.anchor.positioner', [
    'file'     => 'plugins/ui.anchor.positioner.js',
    'type'     => 'plugin',
    'priority' => 130,
    'requires' => [
        'runtime'
    ],
]);

$pipeline->register('ui.context.menu', [
    'file'     => 'plugins/context.menu.js',
    'type'     => 'plugin',
    'priority' => 130,
    'requires' => [
        'runtime',
        'ui.core',
        'ui.hooks'
    ],
]);

$pipeline->register('ui.dropdown.panel', [
    'file'     => 'plugins/dropdown.panel.js',
    'type'     => 'plugin',
    'priority' => 131,
    'preload'  => true,
    'requires' => [
        'runtime',
        'ui.core',
        'ui.hooks',
        'ui.anchor.positioner'
    ],
]);
$pipeline->register('ui.plugin', [
    'file'     => 'plugins/ui.plugin.js',
    'type'     => 'plugin',
    'priority' => 131,
    'preload'  => true,
    'requires' => [
        'runtime',
    ],
]);


/* ==================================================
   COMPILE
================================================== */

$pipeline->compile();