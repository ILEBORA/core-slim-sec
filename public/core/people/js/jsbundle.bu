<?php

require __DIR__ . '/../../../../../../../vendor/autoload.php';

EnvLoader::load(
    __DIR__ . '/../../../../../../../',
    'wahenga'
);

use BoraSlim\Core\Assets\AssetPipelineJs;

$pipeline = new AssetPipelineJs(
    'people',
    __DIR__
);

/* ---------- Global ---------- */

$pipeline->register('people.actions', [
    'file'      => 'plugins/people.actions.js',
    'type'      => 'plugin',
    'priority'  => 10,
    'faces'     => ['client'],
    'preload'   => true
]);

$pipeline->register('people.resources', [
    'file'      => 'plugins/people.resources.js',
    'type'      => 'plugin',
    'priority'  => 20,
    'preload'   => true,
    'routes' => [
        'portal/people',
        'portal/people/*',
        'bo/people',
        'bo/people/*',
    ],
]);

/* ---------- Core ---------- */

$pipeline->register('people.helpers', [
    'file'             => 'utils/PeopleHelpers.js',
    'type'             => 'lib',
    'workspaceService' => true,
    'routes' => [
        'portal/people',
        'portal/people/*',
        'bo/people',
        'bo/people/*',
    ],
]);

$pipeline->register('people.composer', [
    'file'             => 'composer/people.composer.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'people.helpers'
    ],
    'routes' => [
        'portal/people',
        'portal/people/*',
        'bo/people',
        'bo/people/*',
    ],
]);

$pipeline->register('people.ui', [
    'file'             => 'controllers/PeopleUI.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'people.composer'
    ],
    'routes' => [
        'portal/people',
        'portal/people/*',
        'bo/people',
        'bo/people/*',
    ],
]);

$pipeline->register('people.loader', [
    'file'             => 'controllers/PeopleLoader.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'people.ui'
    ],
    'routes' => [
        'portal/people',
        'portal/people/*',
        'bo/people',
        'bo/people/*',
    ],
]);

$pipeline->register('people.follow', [
    'file'             => 'controllers/PeopleFollow.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'people.ui'
    ],
    'routes' => [
        'portal/people',
        'portal/people/*',
        'bo/people',
        'bo/people/*',
    ],
]);

$pipeline->register('people.tree', [
    'file'             => 'controllers/PeopleTree.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'people.loader'
    ],
    'routes' => [
        'portal/people',
        'portal/people/*',
        'bo/people',
        'bo/people/*',
    ],
]);

$pipeline->register('people.presence', [
    'file'             => 'controllers/PeoplePresence.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'people.ui'
    ],
    'routes' => [
        'portal/people',
        'portal/people/*',
        'bo/people',
        'bo/people/*',
    ],
]);

$pipeline->register('people.notifications', [
    'file'             => 'controllers/PeopleNotifications.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'people.ui'
    ],
    'routes' => [
        'portal/people',
        'portal/people/*',
        'bo/people',
        'bo/people/*',
    ],
]);

$pipeline->register('people.realtime', [
    'file'             => 'controllers/PeopleRealtime.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'people.ui'
    ],
    'routes' => [
        'portal/people',
        'portal/people/*',
        'bo/people',
        'bo/people/*',
    ],
]);

$pipeline->register('people.tabs', [
    'file'             => 'controllers/PeopleTabs.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'people.ui'
    ],
    'routes' => [
        'portal/people',
        'portal/people/*',
        'bo/people',
        'bo/people/*',
    ],
]);

$pipeline->register('people.api', [
    'file'             => 'controllers/PeopleAPI.js',
    'type'             => 'lib',
    'workspaceService' => true,

    'requires' => [
        'people.helpers',
        'people.loader',
        'people.tree'
    ],
    'routes' => [
        'portal/people',
        'portal/people/*',
        'bo/people',
        'bo/people/*',
    ],
]);

/* ---------- Plugins ---------- */

$pipeline->register('people.controller', [
    'file' => 'plugins/people.controller.js',
    'type' => 'plugin',

    'faces' => [
        'client'
    ],

    'requires' => [
        'people.helpers',
        'people.ui',

        'people.loader',
        'people.follow',

        'people.api'
    ],
    'routes' => [
        'portal/people',
        'portal/people/*',
        'bo/people',
        'bo/people/*',
    ],
]);

$pipeline->register('people.ui.interactions', [
    'file' => 'plugins/people.ui.interactions.js',
    'type' => 'plugin',
    'routes' => [
        'portal/people',
        'portal/people/{id}'
    ],
]);

$pipeline->register('people.breadcrumbs', [
    'file' => 'plugins/people.breadcrumbs.js',
    'type' => 'plugin',
    'routes' => [
        'portal/people',
        'portal/people/{id}'
    ],
]);

/* ---------- Workspace ---------- */

$pipeline->register('people.workspace', [

    'file'      => 'plugins/people.workspace.js',

    'type'      => 'plugin',

    'workspace' => true,

    'priority'  => 200,

    'routes' => [
        'portal/people',
        'portal/people/{id}'
    ],

    'requires' => [

        'people.controller',

        'people.tabs',

        'people.loader',
        'people.tree',

        'people.follow',

        'people.notifications',
        'people.realtime',

        'people.presence',

        'people.api',
        'people.actions'
    ]
]);

$pipeline
    // ->setDebug(true)
    ->compile();