<?php
require __DIR__ . '/../../../../../../../vendor/autoload.php';

EnvLoader::load(__DIR__ . '/../../../../../../../', 'wahenga');

use BoraSlim\Core\Assets\AssetPipelineJs;

$pipeline = new AssetPipelineJs('pages', __DIR__);

/* ==================================================
   HELPERS
================================================== */

$pipeline->register('page.actions', [
    'file'     => 'plugins/page.actions.js',
    'type'     => 'plugin',
    'priority' => 100,
    'preload'  => true,
    'requires' => ['hooks'],
    'preload' => true
]);

$pipeline->register('menu.resources', [
    'file'     => 'plugins/menu.resources.js',
    'type'     => 'plugin',
    'priority' => 100,
    'preload'  => true,
    'requires' => ['hooks'],
    'preload' => true
]);

$pipeline->register('pages.plugin', [
    'file'     => 'plugins/pages.plugin.js',
    'type'     => 'plugin',
    'priority' => 101,
    'requires' => [
        //'page.actions'
        ],
    'preload'  => true,
]);

/* ==================================================
   COMPILE → manifest
================================================== */

$pipeline->compile();