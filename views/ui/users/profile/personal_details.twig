<div class="inf_block">
    <div class="inf_title">
        <span>{{__t('ui.personal_details',null,'Personal Details')}}</span>
        {% if(hasPermission('profile','edit.personal.details', true)) %}
            <button
                class="btn btn-info flex-right"
                data-popup
                data-mode="form"
                data-module="users"
                data-group="profile"
                data-id="{{id}}"
                data-tab="edit"
                data-size="lg">
                {{__t('ui.button_edit',null,'Edit')}}
            </button>
        {% endif %}
    </div>
    
    <div class="inf_cont shdw" align="center">
        <div class="image_box">  
            <div id="" class="roundedge" style="width:100%;position:relative;z-index:7; overflow:hidden;">
                <a id="" title="Edit" class="avtrBox edit_link r-t" data-itm="{{ id }}" data-id="user" data-prev="{{avatar|raw}}" onclick="return mPGs.changeAvatar(this);">{{__t('ui.button_edit',null,'Edit')}} </a>
                <img 
                    data-bind="user.avatar" 
                    data-bind-attr="src"
                    class="userAvatar{{ id }} lazy" style="width:100%;height:250px;" 
                    src="assets/images/icons/noavatar.png" 
                    data-src="{{avatar|raw}}"
                    />
            </div>   
        </div>
        
        <div class="roundedge info_box">              
            <table id="spm" width="100%" border="0" cellpadding="0" cellspacing="0">

                <tbody><tr>
                    <td align="right" width="20%" valign="middle"><span>{{__t('ui.label.name',null,'Name')}}:</span></td>
                    <td><span data-bind="user.full_name">{{ full_name }}</span></td>
                    <td width="25"></td>
                </tr>
                <tr>
                    <td align="right" valign="middle"><span>{{__t('ui.label.phone',null,'Phone')}}:</span></td>
                    <td><span data-bind="user.phone">{{ phone }}</span></td>
                    <td width="25"></td>
                </tr>
                <tr>
                    <td align="right" valign="middle"><span>{{__t('ui.label.gender',null,'Gender')}}:</span></td>
                    <td><span data-bind="user.gender">{{ gender }}</span></td>
                    <td width="25"></td>
                </tr>
            </tbody></table>
        </div>
        <br clear="all">    
    </div>
    
</div>