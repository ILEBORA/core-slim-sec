<div class="inf_block">
    <div class="inf_title">Location Details 
        <a title="Edit" class="edit_link " onclick="return false;" style="display:none;"></a>

    </div>
    <br clear="left">
    <div class="inf_cont shdw" align="center">                      
        <div class="roundedge info_box">              
            <table id="spm" width="100%" border="0" cellpadding="0" cellspacing="0">

                <tbody>
                <tr style="border: none;">
                    <td align="right" width="20%" valign="middle"><span>Country:</span></td>
                    <td><span id="lable">{{ country }}</span></td>
                    <td width="25"></td>
                </tr>
                <tr style="border: none;">
                    <td align="right" width="20%" valign="middle"><span>County:</span></td>
                    <td><span id="lable">{{ county }}</span></td>
                    <td width="25"></td>
                </tr>
                <tr style="border: none;">
                    <td align="right" valign="middle"><span>Town:</span></td>
                    <td><span id="lable">{{ town }}</span></td>
                    <td width="25"></td>
                </tr>
            </tbody></table>
        </div>
        <br clear="all">    
    </div>
    
</div>