<div class="inf_block">
    <div class="inf_title">
        <span>{{__t('ui.location_details',null,'Location Details')}}</span>
        {% if(hasPermission('profile','edit.location.details', true)) %}
            <button
                class="btn btn-info flex-right"
                data-popup
                data-mode="form"
                data-module="people"
                data-group="person"
                data-id="{{id}}"
                data-tab="edit"
                data-size="lg">
                {{__t('ui.button_edit',null,'Edit')}}
            </button>
        {% endif %}
    </div>
    <br clear="left">
    <div class="inf_cont shdw" align="center">                      
        <div class="roundedge info_box">              
            <table id="spm" width="100%" border="0" cellpadding="0" cellspacing="0">

                <tbody>
                <tr style="border: none;">
                    <td align="right" width="20%" valign="middle"><span>{{__t('ui.country',null,'Country')}}:</span></td>
                    <td><span data-bind="ui.label.country">{{ country }}</span></td>
                    <td width="25"></td>
                </tr>
                <tr style="border: none;">
                    <td align="right" width="20%" valign="middle"><span>{{__t('ui.label.county',null,'County')}}:</span></td>
                    <td><span data-bind="ui.label.county">{{ county }}</span></td>
                    <td width="25"></td>
                </tr>
                <tr style="border: none;">
                    <td align="right" valign="middle"><span>{{__t('ui.label.town',null,'Town')}}:</span></td>
                    <td><span data-bind="ui.label.city">{{ city }}</span></td>
                    <td width="25"></td>
                </tr>
            </tbody></table>
        </div>
        <br clear="all">    
    </div>
    
</div>