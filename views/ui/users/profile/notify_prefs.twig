<div class="inf_block">
    <div class="inf_title">Notification Preferences 
        <a title="Edit" class="edit_link " onclick="return false;" style="display:none;"></a>
    </div>
    <br clear="left">
    <div class="inf_cont shdw">
        <div class="roundedge info_box" align="center">    
            <div class="inf_desc">
                Please choose items you wish to be notified about...
            </div>          
            <table id="spm" width="100%" border="0" cellpadding="0" cellspacing="0">
            <tbody>

            {% if items is empty %}
                <tr>
                    <td colspan="3" align="center" style="padding: 15px; opacity: 0.7;">
                        No items available to subscribe for notifications.
                    </td>
                </tr>
            {% else %}
                {% for item in items %}
                    <tr style="border: none;">

                        <td align="center" style="width:20%;">
                            <span id="lable">
                                <input 
                                    type="checkbox"
                                    checked
                                    data-role="status"
                                    data-id="{{ item.id }}"
                                    onchange="appUI.notify.updateStt(this)"
                                >
                            </span>
                        </td>

                        <td align="left" valign="middle">
                            <span id="lable">{{ item.content|raw }}</span>
                        </td>
                        
                        <td width="25"></td>
                    </tr>
                {% endfor %}
            {% endif %}
            
            </tbody></table>
            <br clear="all">
        </div>
    </div>

    <br clear="all">
</div>