<div class="inf_block">
    <div class="inf_title">
        <span>{{__t('ui.personal_details',null,'Personal Details')}}</span>
        
    </div>

    <br clear="left">

    <div class="inf_cont shdw">
        <div class="roundedge info_box" align="center">    

            <div class="inf_desc">
                {{__t('ui.notification_prefs',null, 'Please choose how you wish to be notified')}}...
            </div>          

            <table id="spm" width="100%" border="0" cellpadding="0" cellspacing="0">
            <tbody>

            {% if groups is empty %}
                <tr>
                    <td colspan="3" align="center" style="padding: 15px; opacity: 0.7;">
                        {{__t('ui.notification.prefs.empty',null,'No notification preferences available')}}.
                    </td>
                </tr>
            {% else %}

                {% for group, items in groups %}

                    <!-- GROUP HEADER -->
                    <tr>
                        <td colspan="3" style="padding:10px 5px; font-weight:600; opacity:0.8;">
                            {{ group|capitalize }}
                        </td>
                    </tr>

                    {% for item in items %}
                        <tr style="border:none;">

                            <!-- CHANNEL CHECKBOXES -->
                            <td align="center" style="width:30%;">
                                {% for ch in item.channels %}
                                    <label style="display:block; font-size:12px; margin-bottom:4px;">
                                        <input 
                                            type="checkbox"
                                            data-role="notify-pref"
                                            data-type="{{ item.type }}"
                                            data-channel="{{ ch.channel }}"
                                            {{ ch.enabled ? 'checked' : '' }}
                                            onchange="updatePref(this)"
                                        >
                                        {{ ch.channel|capitalize }}
                                    </label>
                                {% endfor %}
                            </td>

                            <!-- LABEL -->
                            <td align="left" valign="middle">
                                <span id="lable">{{ item.label }}</span>
                            </td>

                            <td width="25"></td>
                        </tr>
                    {% endfor %}

                {% endfor %}

            {% endif %}
            
            </tbody>
            </table>

            <br clear="all">
        </div>
    </div>

    <br clear="all">
</div>