@if( $appActive == 1 ) 
@set($activeClass="active")
@set($checked="checked")
@set($activeItem="active_item")
@set($statusButtonText="Deactivate")
@set($statusButtonFunct="appServices.deactivate(this)")
@else
@set($activeClass="")
@set($checked="")
@set($activeItem="")
@set($statusButtonText="Activate")
@set($statusButtonFunct="appServices.activate(this)")
@endif

<div class="appservice{{ id }} gridViewItem2 {{ active }} {{ activeItem }}" data-id="{{ id }}" style="position:relative;">
        <span class="service-prog{{ id }}" style="position: absolute;margin-left:5px;"></span>
        <span class="tools-r time" style="position:absolute;right:0;">
            
            <div class="toggle-btn {{ activeClass }}">
                <input type="checkbox"  {{ checked }} class="cb-value service-cb-{{ id }}" onclick="appServices.toggle(this)" />
                <span class="round-btn"></span>
            </div>

         	{{ tools }} 
			<span class="ct{{ id }} cart_count round">{{ quantity }}</span>
			<abbr class="badge" style="">{{ itemscount }}</abbr>
        </span>
        
        <a href="javascript:void(0)" onclick="appServices.open(this)">
            <img class="prod {{ itemclass }}Avatar{{ id }} albart lazyload" data-ref="work" src="assets/images/branding/placeholder.png" data-src="{{ image }}">
        </a>

        <div class="det">
                <div class="service_name" align="center"><b>{{ title }}</b></div>
                <button style="display:none;" onclick="{{ statusButtonFunct }}">{{ statusButtonText }}</button>
        </div>
</div>