<li class="nav-item dropdown" style="margin-right:10px;position:relative;"> 
    <div id="notifications" rel="nofollow" data-target="#" data-bs-toggle="dropdown" 
        aria-haspopup="true" aria-expanded="false" class="nav-link">
            <div class="badge badge-warning {{ badge_class }}" onchange="{{ onchange }}" pointer=""
            data-app-badge="notifications"
            >{{ count }}</div>
            <i class="fa fa-bell {{ icon_class }}"></i>
    </div>
    <ul id="app-notification-dropdown" aria-labelledby="notifications" class="dropdown-menu">
        {{ items }}
        <li>
            <a rel="nofollow" href="javascript:void(0)" onclick="{{ more_link }}" class="dropdown-item all-notifications text-center">
                <strong> 
                    <i class="fa fa-bell"></i>
                        {{ more_text }}
                </strong>
            </a>
        </li>
    </ul>
</li>