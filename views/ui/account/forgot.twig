<section class="auth-form forgot">
  <h2>Forgot Password</h2>
  <p>Enter your email and we’ll send a password reset link.</p>

  <form id="forgotForm" data-action="{{ action }}" method="post" class="ajax-form">
    <div class="form-group">
      <label>Email Address</label>
      <input type="email" name="email" required autofocus>
    </div>

    <button type="submit" class="btn-primary w-full">Send Reset Link</button>
  </form>

  {% include 'account/_auth_links.twig' with { page: 'forgot' } %}
</section>
