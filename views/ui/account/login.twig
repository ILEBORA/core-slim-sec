<section class="auth-form login">
  <h2>Welcome Back</h2>
  <p>Login to access your dashboard and services.</p>

  <form id="loginForm" data-action="{{ action }}" method="post" class="ajax-form">
    <div class="form-group">
      <label>Email Address</label>
      <input type="email" name="email" required autofocus>
    </div>

    <div class="form-group">
      <label>Password</label>
      <input type="password" name="password" required>
    </div>

    <button type="submit" class="btn-primary w-full">Login</button>
  </form>

  {# include 'account/_social.twig' #}
  {% include 'account/_auth_links.twig' with { page: 'login' } %}
</section>

<script>
$(document).on('submit', 'form', function (e) {
	e.preventDefault();
	let form = $(this);
	let action = form.data('action');
	overlayLoader.show('Loading...');
	new CallBora(action)
		.setMethod("POST")
		.setParams(form.serialize())
		.setCallback((res) => {
			if (res.success) {
				appHooks.callHook('after.login');
				alertBora.notify('Successful login...', 'success', 3);
				overlayLoader.show('Logging in...');
				window.location.href = res.lnk || '';
			} else {
				vibrate(100);
				overlayLoader.hide();
				alertBora.error(res.message || 'An error occurred', 5);
				//alertBora.notify(res.message || 'An error occurred', 'error', 4);
			}
		})
		.setDone(() => {
			console.log("Request finished");
			if(typeof authChannel !== 'undefined'){
				authChannel.postMessage({cmd:'login',usr:rd('bID')});
			}
		})
		.setError((xhr) => {
			console.error("Error:", xhr);
			vibrate(100);
			overlayLoader.hide();
			//alertBora.notify('Network error', 'error', 5);
			alertBora.error('Network error', 5);
		})
		.build();
	
});
</script>
