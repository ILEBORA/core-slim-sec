{% if page == 'login' %}
  <div class="auth-links">
    <a href="account/forgot" data-target="account.forgot" class="jx">Forgot password?</a>
    <span>•</span>
    <a href="account/register" data-target="account.register" class="jx">Create an account</a>
  </div>
{% elseif page == 'register' %}
  <div class="auth-links">
    <a href="account/login" data-target="account.login" class="jx">Already have an account? Login</a>
  </div>
{% elseif page == 'forgot' %}
  <div class="auth-links">
    <a href="account/login" data-target="account.login" class="jx">Back to login</a>
    <span>•</span>
    <a href="account/register" data-target="account.register" class="jx">Create an account</a>
  </div>
{% elseif page == 'reset' %}
  <div class="auth-links">
    <a href="account/login" data-target="account.login" class="jx">Return to login</a>
  </div>
{% endif %}
