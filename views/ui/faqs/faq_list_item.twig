<li id="item{{ id }}" class="{{ class }} " >
   
    <span class="toggle faq_question" onclick="mPGs.acToggle(this,event)">
        <span class="f-right">
            {{ options }}
        </span>
        <i class="fa fa-check-circle"></i> {{ question }}
    </span>
    <ul class="inner {{ ulclass }} faq_answer">
        {{ answer }}
    </ul>
</li>