        <span class="time">Dash Tools</span> <i class="toggle-icon fa fa-cogs"></i>
    </div>

    <!-- Dash Controls -->
    <div class="temp-controls">
        <span class="tools f-right">
            {{ title }} | <button onclick="mPGs.klassPopup('LayoutTempSections','addto','{{ title }}','addto')">Add Sections</button> | <button onclick="lnk('p:admin-r:manage-sb:dashsections')">Manage Sections</button> 
        </span>
    </div>
</div>