<div class="{{ wrapper }} checkbox-wrapper-0">
    <input
        type="{{ type }}"    
        id="{{ parseID }}{{ name }}"  
        name="{{ name }}"
        data-id="{{ parseID }}"
        class="custom-check orr {{ itemClass }} {{ frm }} "
        value="{{ value }}" 
        {{ extras }} />

    <label for="{{ parseID }}{{ name }}">{{ placeholder }}</label>
</div>