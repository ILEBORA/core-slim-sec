<tr class="lbl {{ displaycls }}" id="tr-{{name}}" {{ display }} >
    <td >
        <div align="right">
            <span class="label">{{ label|raw }}</span>
             {% if required %}
                <span class="star">*</span>
            {% endif %}
        </div>
    </td>
    <td style="padding:10px;"> 
        {{ element|raw }} 
        {{ content|raw }}
        <div id="{{ parseID }}{{ name }}_stt" class="inf"></div>
    </td>
    <td width="30" align="right">
        <span id="{{ parseID }}{{ name }}_img" class="_img"></span>
    </td>
</tr>