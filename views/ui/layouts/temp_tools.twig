<!-- Dash Controls Container -->
<div class="temp-controls-container">
    <span class="handle"><abbr class="fa fa-move">m</abbr></span> &nbsp;
    <!-- Toggle Icon -->
    <div class="temp-controls-toggle">
        <span class="time">Temp Tools</span> <i class="toggle-icon fa fa-cogs"></i>
    </div>

    <!-- Dash Controls -->
    <div class="temp-controls">
        <span class="tools f-right">
            {{ title }} | <button onclick="mPGs.klassPopup('LayoutTempSections','addto','{{ title }}','addto')">Add Sections</button> | <button onclick="lnk('p:admin-r:manage-sb:tempsections')">Manage Sections</button> 
        </span>
    </div>
</div>

<script>
$(function(){
    $('.temp-controls-container').draggable({
        handle: '.handle',
        revert: false, 
        placeholder: true,
        // droptarget: '.drop',
        // drop: function(evt, droptarget) {
        // $(this).appendTo(droptarget).draggable('destroy');
        // }
    });
});
</script>