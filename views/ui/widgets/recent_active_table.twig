<div class="widget_table">
    <h3>{{ title }}</h3>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th><th>Email</th><th>Last Seen</th>
            </tr>
        </thead>
        <tbody>
            {% for r in rows %}
            <tr>
                <td>{{ r.fullname }}</td>
                <td>{{ r.email }}</td>
                <td>{{ r.last_seen }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>