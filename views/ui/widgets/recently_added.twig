<div class="widget_container small-list">
    <h4>{{ title }}</h4>

    <ul class="recent-list">
        {% for item in list %}
            <li>
                <strong>{{ item.fullname }}</strong>
                <span>{{ item.email }}</span>
                <em>{{ item.created_at }}</em>
            </li>
        {% endfor %}
    </ul>

    {% if link %}
        <a href="{{ link }}" class="more-link">See all →</a>
    {% endif %}
</div>