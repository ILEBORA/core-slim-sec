<!-- Dash Controls Container -->
<div class="dash-controls-container">
    <!-- Toggle Icon -->
    <div class="dash-controls-toggle">
        <span class="time">Dash Tools</span> <i class="toggle-icon fa fa-cogs"></i>
    </div>

    <!-- Dash Controls -->
    <div class="dash-controls">
        <span class="tools f-right">
            {{title}} | <button onclick="
                                    mPGs.klassPopup(
                                            'dashboards',
                                            'dashpagewidgets',
                                            '{{id}}',          // item id
                                            'add',     // form action
                                            () => console.log('Opening edit form...'),
                                            () => console.log('Edit closed.')
                                        );
                                    ">Add Widgets</button> | <button onclick="lnk('p:bo-r:manage-sb:dashwidgets')">Manage Widgets</button> 
        </span>
    </div>
</div>