{% block content %}
<div class="main_container container details_box">
    <div style="background: url('assets/images/icons/bck_wht.png') top left repeat; padding:3px;">
        <h2>Theme Styler</h2>

        {% if hasPermission('Themes', 'viewThemes', true) %}
            <div>
                <table class="pm" width="100%">
                    <tbody>
                        <tr>
                            <td class="custom-lable" style="text-align:right;width:50px;">Theme:</td>
                            <td style="text-align:left;">
                                <select id="themeselector" name="themeselector" class="custom-input" style="width:250px;">
                                    <option value="0">Select Theme</option>
                                    {% for id, title in themeOptions %}
                                         <option value="{{ id }}" {% if id == currentTheme %}selected{% endif %}>{{ title }}</option>
                                    {% endfor %}
                                </select>
                            </td>
                            <td>{{ buttons.addThemeBtn|raw }} {{ buttons.exportThemeBtn|raw }} {{ buttons.importThemeBtn|raw }}</td>
                        </tr>

                        <tr>
                            <td class="custom-lable" style="text-align:right;vertical-align:top;">Item:</td>
                            <td style="text-align:left;">
                                <select id="themeitem" name="themeitem" class="custom-input" style="width:250px;">
                                    <option value="blank">Select Item</option>
                                </select>
                            </td>
                            <td>{{ buttons.addItemBtn|raw }}</td>
                        </tr>

                        <tr>
                            <td class="custom-lable" style="text-align:right;vertical-align:top;">Style:</td>
                            <td><ul id="themestyle_block" class="perm-list accordion"></ul></td>
                            <td>{{ buttons.addItemStyleBtn|raw }}</td>
                        </tr>
                    </tbody>
                </table>
            
            </div>
        {% else %}
            <p>You do not have permission to view this page!</p>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>

$(document).ready(function(){
    const themeEditor = $('#themestyle_block');
    themeEditor.html('');

    //$('#themeselector').select2();
    //$('#themeitem').select2();

    $('#themeselector').trigger('change');

    $('#themeselector').change(function(){
        const rid = $(this).val();
        if(rid != 0){
            themeEditor.html('<div align="center"><img src="assets/images/icons/ajax.gif"/></div>');
            new CallBora("api/modules/themes/sections")
            .setMethod("POST")
            .setParams({id:rid})
            .setCallback((res) => {
                themeEditor.html('');
                $('#themeitem').html(res.data);
            })
            .setDone(() => {
                console.log("Request finished");
                
            })
            .setError((xhr) => console.error("Error:", xhr))
            .build();
        }
    });

    $('#themeitem').change(function(){
        const rid = $('#themeselector').val();
        const pid = $(this).val();
        if(rid != 0){
            themeEditor.html('<div align="center"><img src="assets/images/icons/ajax.gif"/></div>');
            new CallBora("api/modules/themes/items")
            .setMethod("POST")
            .setParams({id:rid,sid:pid})
            .setCallback((res) => {
                themeEditor.html(res.data);
            })
            .setDone(() => {
                console.log("Request finished");
                
            })
            .setError((xhr) => console.error("Error:", xhr))
            .build();
        }
    });

    
});
 




</script>
{% endblock %}