<h1 class="page-title">Modules</h1>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Module</th>
            <th>Version</th>
            <th>Status</th>
            <th>Admin</th>
            <th>Notes</th>
            <th style="width: 160px;">Actions</th>
        </tr>
    </thead>
    <tbody>

    {% for m in modules %}

        {% set adminAvailable = m.hasAdmin() %}
        {% set classOk = m.classExists() %}

        <tr class="
            {% if not classOk %} table-danger
            {% elseif not m.enabled %} table-warning
            {% endif %}
        ">
            <td>
                <strong>{{ m.name }}</strong>
                {% if m.is_core %}
                    <span class="badge bg-secondary">core</span>
                {% endif %}
            </td>

            <td>{{ m.version }}</td>

            <td>
                {% if m.enabled %}
                    <span class="badge bg-success">Enabled</span>
                {% else %}
                    <span class="badge bg-danger">Disabled</span>
                {% endif %}
            </td>

            <td>
                {% if adminAvailable %}
                    <span class="badge bg-success">Yes</span>
                {% else %}
                    <span class="badge bg-secondary">No</span>
                {% endif %}
            </td>

            <td>
                {% if not classOk %}
                    <span class="text-danger">
                        Class not found
                    </span>
                {% elseif m.enabled and not adminAvailable %}
                    <span class="text-muted">
                        No admin controller
                    </span>
                {% else %}
                    —
                {% endif %}
            </td>

            <td>
                {# if m.enabled and adminAvailable #}
                    <a href="bo/{{ m.name|lower|replace({' ': '-'}) }}"
                       class="btn btn-sm btn-primary">
                        Open 
                    </a>
                {# endif #}

                {% if not m.is_core %}
                    {% if m.enabled %}
                        <button
                            class="btn btn-sm btn-warning"
                            data-module-id="{{ m.id }}"
                            data-action="disable"
                            onclick="modControl.toggleModule(this);;">
                            Disable
                        </button>
                    {% else %}
                        <button
                            class="btn btn-sm btn-warning"
                            data-module-id="{{ m.id }}"
                            data-action="enable"
                            onclick="modControl.toggleModule(this);;">
                            Enable
                        </button>
                    {% endif %}
                {% endif %}
            </td>
        </tr>

    {% else %}
        <tr>
            <td colspan="6" class="text-center text-muted">
                No modules registered
            </td>
        </tr>
    {% endfor %}

    </tbody>
</table>