<div class="container">
  <h2>Module Health</h2>

  <table>
    <tr>
      <th>Module</th>
      <th>Status</th>
      <th>Issues</th>
    </tr>

    {% for name, h in health %}
    <tr>
      <td>{{ name }}</td>
      <td>
        {% if h.healthy %}
          <span class="ok">Healthy</span>
        {% else %}
          <span class="bad">Attention</span>
        {% endif %}
      </td>
      <td>
        {% if h.dependency_errors %}
          <ul>
          {% for e in h.dependency_errors %}
            <li>{{ e }}</li>
          {% endfor %}
          </ul>
        {% else %}
          —
        {% endif %}
      </td>
    </tr>
    {% endfor %}
  </table>
</div>