<div class="container">
    <h1 class="page-title">Module Not Found</h1>

    <div class="alert alert-warning">
        <strong>{{ module.name }}</strong> was not found in this application.
    </div>

    <p class="text-muted mt-3">
        This usually means one of the following:
    </p>

    <ul class="text-muted">
        <li>The module name is misspelled</li>
        <li>The module has not been installed</li>
        <li>The admin capability is disabled in <code>meta()</code></li>
    </ul>

    <div class="mt-4">
        <span onclick="appUI.content.loadPage('bo/control')" class="btn btn-secondary">
            Back to Modules
        </span>
    </div>
</div>