{# Events/Views/attendee/list.twig #}

{# extends layout('main') #}

{% block content %}

<div class="event-attendee-list-page container">

    <div class="page-header">

        <div>

            <h1>
                Event Attendees
            </h1>

            <p class="text-muted">

                {{ event.title }}

            </p>

        </div>

        <div>

            <button
                class="btn btn-outline-primary"
                data-action="event.export-attendees"
                data-event-id="{{ event.id }}"
            >

                <i class="fas fa-download"></i>

                Export

            </button>

        </div>

    </div>

    <div class="card">

        <div class="card-body">

            {% if attendees %}

                <table class="table attendee-table">

                    <thead>

                        <tr>

                            <th>
                                Attendee
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Ticket
                            </th>

                            <th>
                                Checked In
                            </th>

                            <th>
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        {% for attendee in attendees %}

                            <tr>

                                <td>

                                    <div class="attendee-inline">

                                        {% if attendee.avatar_upload_id %}

                                            <img
                                                src="{{ media(attendee.avatar_upload_id) }}"
                                                class="avatar-sm"
                                            >

                                        {% endif %}

                                        <div>

                                            <div>

                                                {{ attendee.username|default(attendee.guest_name|default('Guest')) }}

                                            </div>

                                            {% if attendee.guest_email %}

                                                <small class="text-muted">

                                                    {{ attendee.guest_email }}

                                                </small>

                                            {% endif %}

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    <span class="status-badge">

                                        {{ attendee.status|replace({'_':' '})|title }}

                                    </span>

                                </td>

                                <td>

                                    {{ attendee.ticket_code|default('-') }}

                                </td>

                                <td>

                                    {% if attendee.checked_in_at %}

                                        {{ attendee.checked_in_at|date('M d, H:i') }}

                                    {% else %}

                                        <span class="text-muted">

                                            No

                                        </span>

                                    {% endif %}

                                </td>

                                <td>

                                    <div class="table-actions">

                                        <button
                                            class="btn btn-sm btn-outline-primary"
                                            data-action="event.checkin"
                                            data-user-id="{{ attendee.user_id }}"
                                            data-event-id="{{ event.id }}"
                                        >

                                            Check In

                                        </button>

                                        <button
                                            class="btn btn-sm btn-outline-danger"
                                            data-action="event.remove-attendee"
                                            data-user-id="{{ attendee.user_id }}"
                                            data-event-id="{{ event.id }}"
                                        >

                                            Remove

                                        </button>

                                    </div>

                                </td>

                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            {% else %}

                {% include "events/partials/empty-state.twig" with {
                    title: 'No attendees',
                    message: 'No attendees have registered yet.'
                } %}

            {% endif %}

        </div>

    </div>

</div>

{% endblock %}