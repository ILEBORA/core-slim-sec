{# Events/Views/partials/related-events.twig #}

<div class="related-events-widget">

    <div class="widget-header">

        <h3>
            Related Events
        </h3>

    </div>

    <div class="widget-content">

        {% if related %}

            <div class="related-events-list">

                {% for event in related %}

                    {% include "events/partials/mini-event-card.twig" with {
                        event: event
                    } %}

                {% endfor %}

            </div>

        {% else %}

            <div class="text-muted">

                No related events found

            </div>

        {% endif %}

    </div>

</div>