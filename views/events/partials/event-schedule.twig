{# Events/Views/partials/event-schedule.twig #}

<div class="event-schedule card">

    <div class="card-header">

        Schedule

    </div>

    <div class="card-body">

        <div class="schedule-item">

            <div class="schedule-label">

                Starts

            </div>

            <div class="schedule-value">

                {{ event.starts_at|date('F d, Y H:i') }}

            </div>

        </div>

        {% if event.ends_at %}

            <div class="schedule-item">

                <div class="schedule-label">

                    Ends

                </div>

                <div class="schedule-value">

                    {{ event.ends_at|date('F d, Y H:i') }}

                </div>

            </div>

        {% endif %}

        {% if event.timezone %}

            <div class="schedule-item">

                <div class="schedule-label">

                    Timezone

                </div>

                <div class="schedule-value">

                    {{ event.timezone }}

                </div>

            </div>

        {% endif %}

    </div>

</div>