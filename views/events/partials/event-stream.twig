{# Events/Views/partials/event-stream.twig #}

<div class="event-stream">

    <div class="stream-header">

        <h3>
            Live Activity
        </h3>

    </div>

    <div
        class="stream-feed"
        data-stream="events.{{ event.id }}"
    >

        <div class="text-muted">

            Waiting for updates...

        </div>

    </div>

</div>