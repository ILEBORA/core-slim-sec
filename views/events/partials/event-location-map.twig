{# Events/Views/partials/event-location-map.twig #}

<div
    class="event-location-map"
    data-lat="{{ event.latitude }}"
    data-lng="{{ event.longitude }}"
>

    <div class="map-placeholder">

        <i class="fas fa-map-marked-alt"></i>

        <span>
            Map Loading...
        </span>

    </div>

</div>