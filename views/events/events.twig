{# Events/Views/events.twig #}

{% block content %}

<div class="events-page container">

    <div class="page-header">

        <div>

            <h1>{{ title|default('Events')}}</h1>

            <p class="text-muted">
                Discover upcoming events and experiences
            </p>

        </div>

        <div class="page-actions-n">

            <button
                data-action="event.add"
                class="btn btn-primary"
            >
                <i class="fas fa-plus"></i>
                Create Event
            </button>

        </div>

    </div>

    {# =======================================================
     # FILTERS
     # ===================================================== #}

    <div class="events-filters">

        <button
            data-nav="portal/events?filter=published"
            class="
                btn btn-sm
                {{ activeFilter == "published"
                    ? "btn-primary"
                    : "btn-light"
                }}
            "
        >
            Published
        </button>

        <button
            data-nav="portal/events?filter=all"
            class="
                btn btn-sm
                {{ activeFilter == "all"
                    ? "btn-primary"
                    : "btn-light"
                }}
            "
        >
            All
        </button>

        <button
            data-nav="portal/events?filter=drafts"
            class="
                btn btn-sm
                {{ activeFilter == "drafts"
                    ? "btn-primary"
                    : "btn-light"
                }}
            "
        >
            Your Drafts
        </button>

        <button
            data-nav="portal/events?filter=deleted"
            class="
                btn btn-sm
                {{ activeFilter == "deleted"
                    ? "btn-danger"
                    : "btn-light"
                }}
            "
        >
            Deleted
        </button>

        <button
            data-nav="portal/events?filter=past"
            class="
                btn btn-sm
                {{ activeFilter == "past"
                    ? "btn-primary"
                    : "btn-light"
                }}
            "
        >
            Past
        </button>

    </div>

    {# =======================================================
     # SEARCH
     # ===================================================== #}

    <div class="events-search">

        <form
            method="GET"
            action="portal/events/search"
            class="events-search-form"
        >

            <input
                type="text"
                name="q"
                class="form-control"
                placeholder="Search events..."
                value=""
            >

            <button
                type="submit"
                class="btn btn-primary"
            >
                <i class="fas fa-search"></i>
                Search
            </button>

        </form>

    </div>

    {# =======================================================
     # EVENTS
     # ===================================================== #}

    {% if events %}

        <div class="events-grid">

            {% for event in events %}

                {% include
                    "events/partials/event-card.twig"
                    with {
                        event: event
                    }
                %}

            {% endfor %}

        </div>

    {% else %}

        {% include
            "events/partials/empty-state.twig"
            with {

                title:"No events found",

                message:
                    "There are currently no events available."
            }
        %}

    {% endif %}

</div>

{% endblock %}