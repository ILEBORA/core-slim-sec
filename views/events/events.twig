{# Events/Views/events.twig #}


{% block content %}

<div class="events-page container">

    <div class="page-header">

        <div>
            <h1>Events</h1>

            <p class="text-muted">
                Discover upcoming events and experiences
            </p>
        </div>

        <div class="page-actions">

            <button
                data-action="event.add"
                class="btn btn-primary"
            >
                <i class="fas fa-plus"></i>
                Create Event
            </button>

        </div>

    </div>

    <div class="events-search">

        <form
            method="GET"
            action="portal/events/search"
        >

            <input
                type="text"
                name="q"
                class="form-control"
                placeholder="Search events..."
            >

        </form>

    </div>

    {% if events %}

        <div class="events-grid">

            {% for event in events %}

                {% include "events/partials/event-card.twig" with {
                    event: event
                } %}

            {% endfor %}

        </div>

    {% else %}

        {% include "events/partials/empty-state.twig" with {
            title: 'No events found',
            message: 'There are currently no events available.'
        } %}

    {% endif %}

</div>

{% endblock %}