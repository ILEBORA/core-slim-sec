{# extends layout('admin') #}

{% block content %}

<div class="events-admin-dashboard container">

    {% include "events/partials/admin-topbar.twig" %}

    <div class="stats-grid">

        {% include "events/partials/admin-stat-card.twig" with {
            title: 'Total Events',
            value: stats.total
        } %}

        {% include "events/partials/admin-stat-card.twig" with {
            title: 'Live Events',
            value: stats.live
        } %}

        {% include "events/partials/admin-stat-card.twig" with {
            title: 'Drafts',
            value: stats.drafts
        } %}

    </div>

    <div class="dashboard-layout">

        <div class="dashboard-main">

            {% include "events/widgets/pending-events.twig" %}

            {% include "events/widgets/realtime-feed.twig" %}

        </div>

        <div class="dashboard-sidebar">

            {% include "events/widgets/quick-stats.twig" %}

        </div>

    </div>

</div>

{% endblock %}