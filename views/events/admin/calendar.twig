{% block content %}

<div class="page-header container">

    <div>
        <h1 class="page-title">
            Events Calendar
        </h1>

        <p class="page-subtitle">
            Manage and review scheduled events.
        </p>
    </div>

    <div class="page-actions-n">

        <button
            data-action="event.add"
            class="btn btn-primary"
        >
            <i class="fas fa-plus"></i>
            Create Event
        </button>

    </div>

</div>

<form
    method="GET"
    action="bo/events/calendar"
    class="calendar-filters card container"
>

    <div class="grid grid-cols-2 gap-3">

        <div class="form-group">

            <label>
                Start Date
            </label>

            <input
                type="date"
                name="start"
                value="{{ start }}"
                class="form-control"
            >

        </div>

        <div class="form-group">

            <label>
                End Date
            </label>

            <input
                type="date"
                name="end"
                value="{{ end }}"
                class="form-control"
            >

        </div>

    </div>

    <div class="mt-3">

        <button
            type="submit"
            class="btn btn-secondary"
        >
            Filter
        </button>

    </div>

</form>

<div class="card mt-4  container">

    <div class="card-header">

        <h3>
            Scheduled Events
        </h3>

    </div>

    <div class="card-body">

        {% if events|length %}

            <table class="table">

                <thead>

                    <tr>

                        <th>
                            Event
                        </th>

                        <th>
                            Start
                        </th>

                        <th>
                            End
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Featured
                        </th>

                        <th width="120">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    {% for event in events %}

                        <tr>

                            <td>

                                <div class="event-title">

                                    <a href="bo/event/{{ event.id }}">

                                        {{ event.title }}

                                    </a>

                                </div>

                                {% if event.location %}

                                    <div class="text-muted text-sm">

                                        {{ event.location }}

                                    </div>

                                {% endif %}

                            </td>

                            <td>

                                {{ event.start_date|date('M d, Y H:i') }}

                            </td>

                            <td>

                                {{ event.end_date|date('M d, Y H:i') }}

                            </td>

                            <td>

                                <span class="badge badge-status">

                                    {{ event.status }}

                                </span>

                            </td>

                            <td>

                                {% if event.is_featured %}

                                    <span class="badge badge-success">

                                        Featured

                                    </span>

                                {% else %}

                                    <span class="text-muted">

                                        No

                                    </span>

                                {% endif %}

                            </td>

                            <td>

                                <div class="table-actions">

                                    <a
                                        href="bo/event/{{ event.id }}"
                                        class="btn btn-sm"
                                    >
                                        View
                                    </a>

                                    <a
                                        href="bo/event/{{ event.id }}/edit'"
                                        class="btn btn-sm btn-secondary"
                                    >
                                        Edit
                                    </a>

                                </div>

                            </td>

                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        {% else %}

            <div class="empty-state">

                <h4>
                    No Events Found
                </h4>

                <p>
                    No events exist within the selected date range.
                </p>

            </div>

        {% endif %}

    </div>

</div>

{% endblock %}