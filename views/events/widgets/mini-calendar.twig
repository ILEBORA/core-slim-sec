{# Events/Views/widgets/mini-calendar.twig #}

<div class="events-widget mini-calendar-widget">

    <div class="widget-header">

        <h3>
            Calendar
        </h3>

    </div>

    <div class="widget-content">

        {% if events %}

            {% for event in events %}

                {% include "events/partials/calendar-card.twig" with {
                    event: event
                } %}

            {% endfor %}

        {% else %}

            <div class="text-muted">

                No scheduled events

            </div>

        {% endif %}

    </div>

</div>