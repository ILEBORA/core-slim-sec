{# Events/Views/widgets/upcoming.twig #}

<div class="events-widget upcoming-events-widget">

    <div class="widget-header">

        <h3>
            Upcoming Events
        </h3>

    </div>

    <div class="widget-content">

        {% if events %}

            {% for event in events %}

                {% include "events/partials/mini-event-card.twig" with {
                    event: event
                } %}

            {% endfor %}

        {% else %}

            <div class="text-muted">

                No upcoming events

            </div>

        {% endif %}

    </div>

</div>