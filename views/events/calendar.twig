<div class="events-calendar-page container">

    <div class="calendar-toolbar">

        <div class="calendar-nav">

            <button data-calendar-prev>
                Prev
            </button>

            <button data-calendar-today>
                Today
            </button>

            <button data-calendar-next>
                Next
            </button>

        </div>

        <div class="calendar-view-switch">

            <button data-view="day">
                Day
            </button>

            <button data-view="week">
                Week
            </button>

            <button data-view="month"
                    class="active">
                Month
            </button>

            <button data-view="year">
                Year
            </button>

        </div>

    </div>

    <div
        class="calendar-content"
        data-calendar-view="month"
        data-start="{{ start }}"
        data-end="{{ end }}"
    >

        {% include "events/calendar/month.twig" %}

    </div>

</div>