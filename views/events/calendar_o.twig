{# Events/Views/calendar.twig #}

{# extends layout('main') #}

{% block content %}

<div class="events-calendar-page container">

    <div class="page-header">

        <div>

            <h1>Events Calendar</h1>

            <p class="text-muted">
                Browse upcoming events by date
            </p>

        </div>

    </div>

    <div class="calendar-wrapper card">

        <div class="card-body">

            <div
                class="events-calendar"
                data-start="{{ start }}"
                data-end="{{ end }}"
            >

                {% if events %}

                    <div class="calendar-events">

                        {% for event in events %}

                            {% include "events/partials/calendar-card.twig" with {
                                event: event
                            } %}

                        {% endfor %}

                    </div>

                {% else %}

                    {% include "events/partials/empty-state.twig" with {
                        title: 'No calendar events',
                        message: 'There are no events scheduled for this period.'
                    } %}

                {% endif %}

            </div>

        </div>

    </div>

</div>

{% endblock %}