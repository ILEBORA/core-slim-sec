<h1>{{ person.first_name }} {{ person.last_name }}</h1>

<nav class="tabs">
    <a href="portal/person/{{person.id}}?tab=profile">Profile</a>
    <a href="portal/person/{{person.id}}?tab=activity">Activity</a>
    <a href="portal/person/{{person.id}}?tab=events">Events</a>
    <a href="portal/person/{{person.id}}?tab=tree">Tree</a>
</nav>

<div class="tab-content">
{% if tab == 'profile' %}
    <p>Born: {{ person.birth_year ?: 'Unknown' }}</p>
    {% if person.is_deceased %}
        <p>Died: {{ person.death_year ?: 'Unknown' }}</p>
    {% endif %}
    <p>Gender: {{ person.gender }}</p>
{% endif %}

{% if tab == 'activity' %}
    activity tab
    {% include "people/portal/people/partials/activity.twig" %}
{% endif %}

{% if tab == 'events' %}
    {% include "people/portal/people/partials/events.twig" %}
{% endif %}

{% if tab == 'tree' %}
    <div id="tree-container"></div>
    <!-- JS loads the tree view -->
{% endif %}
</div>
