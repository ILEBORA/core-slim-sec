<div class="container people-page">

    <h1>People</h1>

    <form class="people-search" method="get" action="portal/people/search">
        <input type="text" name="q" placeholder="Search people..." />
        <button type="submit">Search</button>
    </form>

    <div class="view-toggle">
        <button data-view="grid">Grid</button>
        <button data-view="list">List</button>
    </div>

    $('.view-toggle button').on('click', function(){
        const view = $(this).data('view');
        $('.people-grid')
            .toggleClass('list-view', view === 'list');
    });
    <div class="people-grid">

    {% for person in people %}
        <a class="person-card" href="portal/person/{{ person.id }}" data-person="{{ person.id }} data.>

            <div class="avatar">
                <img class="personAvatar{{ person.id }}" src="{{ person.avatar_url ?: 'assets/images/icons/noavatar.png' }}">
            </div>

            <div class="person-name">
                {{ person.first_name }} {{ person.last_name }}
            </div>

            <div class="person-tags">
                {% if person.is_placeholder %}
                    <span class="tag">Placeholder</span>
                {% endif %}

                {% if person.is_deceased %}
                    <span class="tag deceased">†</span>
                {% endif %}
            </div>

        </a>
    {% endfor %}

    </div>

</div>