<div class="person-page container">

    <div class="person-header">
        <div class="person-avatar">
            <img class="userAvatar{{ user.id }} lazy" src="assets/images/icons/noavatar.png" data-src="{{user.avatar_url}}"  style="width:100%;height:250px;" />
        </div>

        <div class="person-meta">
            <h1>{{ person.first_name }} {{ person.last_name }}</h1>

            <div class="person-tags">
                {% if person.is_placeholder %}
                    <span class="tag">Placeholder</span>
                {% endif %}

                {% if person.is_deceased %}
                    <span class="tag deceased">† Deceased</span>
                {% endif %}
            </div>

            <div class="person-actions">
                {% if hasUser and not person.is_deceased %}
                    <button 
                        class="btn primary follow-btn" 
                        data-user-id="{{ person.user_id }}"
                        data-following="{{ isFollowing ? 1 : 0 }}"
                    >
                        {{ isFollowing ? 'Following' : 'Follow' }}
                    </button>

                    <button class="btn">Message</button>
                {% endif %}
            </div>
        </div>
    </div>

    <nav class="tabs">
        <a class="{{ tab=='profile' ? 'active' }}" href="portal/person/{{person.id}}?tab=profile">Profile</a>
        <a class="{{ tab=='activity' ? 'active' }}" href="portal/person/{{person.id}}?tab=activity">Activity</a>
        <a class="{{ tab=='events' ? 'active' }}" href="portal/person/{{person.id}}?tab=events">Events</a>
        <a class="{{ tab=='tree' ? 'active' }}" href="portal/person/{{person.id}}?tab=tree">Tree</a>
    </nav>

    <div class="tab-content">

        {% if tab == 'profile' %}
            <div class="card profile-info">
                <p><strong>Born:</strong> {{ person.birth_year ?: 'Unknown' }}</p>

                {% if person.is_deceased %}
                    <p><strong>Died:</strong> {{ person.death_year ?: 'Unknown' }}</p>
                {% endif %}

                <p><strong>Gender:</strong> {{ person.gender ?: 'Unknown' }}</p>
            </div>
        {% endif %}

        {% if tab == 'activity' %}
            {% include "people/portal/people/partials/activity.twig" %}
        {% endif %}

        {% if tab == 'events' %}
            {% include "people/portal/people/partials/events.twig" %}
        {% endif %}

        {% if tab == 'tree' %}
            <div id="tree-container"></div>
        {% endif %}

    </div>

</div>

<script>
$(document).on('click', '.follow-btn', function () {
    const btn = $(this);
    const userId = btn.data('user-id');

    $.post('portal/follow/toggle', { user_id: userId }, function (res) {

        if (res.status === 'followed') {
            btn.text('Following');
            btn.attr('data-following', 1);
        } else {
            btn.text('Follow');
            btn.attr('data-following', 0);
        }

    });
});
</script>