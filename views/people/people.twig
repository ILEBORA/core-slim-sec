<div class="inbox-layout people"
     data-view="{{ data_view|default('list') }}">

    {{ lvui|raw }}

    {# ===============================
       SIDEBAR
    =============================== #}
    <aside class="inbox-sidebar">

        <div class="inbox-header">
            <span><h3>People</h3></span>
            <button class="new-thread-btn" title="New Person">+</button>
        </div>

        <div class="thread-search">
            <input
                type="search"
                placeholder="Search People"
                aria-label="Search people"
                data-people-search
            >

            <button
                class="filter-all"
                aria-pressed="false"
                title="Show online only"
                data-people-filter="all">
                ●
            </button>
        </div>

        <div class="people-filters">
            <button data-type="all" class="active">All</button>
            <button data-type="members">Members</button>
            <button data-type="non-users">Non-Users</button>
            <button data-type="favorites">Favorites</button>
        </div>

        <ul class="people-list people-grid" lvui="people_threads">

            {% for person in people %}
                {% set d_state = person.is_deleted ? 'deleted' : '' %}
                {% set fav_state = person.is_favorite ? 'is-fav' : '' %}
                <div class="person-card {{ d_state }}"
                     data-person="{{ person.id }}"
                     data-action="people:open"
                     data-type="{{ person.user_id ? 'members' : 'non-users' }}"
                     data-favorite="{{ person.is_favorite ? 1 : 0 }}"
                     >

                    <div class="card-actions">
                        <button class="favorite-toggle {{ fav_state }}" data-id="{{ person.id }}"  title="Add to favorites" data-action="act-favorite-toggle">
                            <i class="icon-star"></i>
                        </button>
                    </div>

                    <div class="avatar">
                        <img class="lazy  userAvatar{{person.user_id}}" src="assets/images/icons/noavatar.png" data-src="{{person.avatar_url}}" />
                        <span class="status-dot"></span>
                    </div>

                    <div class="name">
                        {{ person.full_name }}
                    </div>

                </div>
            {% endfor %}

        </ul>
    </aside>


    {# ===============================
       MAIN CONTENT
    =============================== #}
    <main class="inbox-content">

        {% block inbox_content %}
            {# thread view #}
            <div class="thread-view person-view" data-person="null">
                <div class="empty-state"> Select a person </div>
            </div>
            
        {% endblock %}

    </main>


    {# ===============================
       FLOATING ACTION BUTTON
    =============================== #}
    <button
        class="fab-new-thread"
        aria-label="New conversation"
        title="New conversation"
        >
        +
    </button>

    {# ⚙️ ACTIONS #}
    <div class="page-actions f-right">

        {% if person.id is defined %}
            <button
                class="thread_context_menu"
                data-context-trigger
                data-context-type="person"
                data-context-id="{{ person.id }}"
            >
                ⋮
            </button>
        {% endif %}

    </div>
</div>
