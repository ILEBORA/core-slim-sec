{% extends "people/people.twig" %}

{% block inbox_content %}

{% set view_composer = (data_view == 'list' or error) ? 'hidden' : '' %}

<div class="thread-view" data-person="{{ person.id }}">
    {% include "people/person/header.twig" with {
        person: person
    } %}

    <div class="messages-cont2">
            {# ERROR STATE #}
            {% if error %}
                
                <div class="thread-error">
                    <div class="error-box">
                        <h4>⚠️ Something went wrong</h4>
                        <p>{{ error }}</p>

                        <button class="btn retry-btn" onclick="location.reload()">
                            Retry
                        </button>
                    </div>
                </div>

            {# EMPTY / LIST STATE #}
            {% elseif data_view == 'list' or not thread %}
                <div class="empty-state"> Select a person </div>
            {# NORMAL THREAD VIEW #}
            {% else %}
                ...
            {% endif %}
        
    </div>

</div>

<script>
    window.MAIN_USER_ID = rd('uID');
</script>

{% if person.id is defined and not error %}
<script>
    window.INBOX_THREAD_ID = {{ person.id }};

    $(function(){
        $('.thread-item[data-id="{{ person.id }}"]').addClass('selected');
    });
</script>
{% endif %}

{% endblock %}