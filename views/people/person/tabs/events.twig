{# people/person/tabs/events.twig #}

<div class="events-list">

    {% if events is empty %}
        <div class="empty-state">
            No events available
        </div>
    {% else %}

        {% for event in events %}
            <div class="event-item">

                <div class="event-title">
                    {{ event.title }}
                </div>

                <div class="event-date">
                    {{ event.date }}
                </div>

            </div>
        {% endfor %}

    {% endif %}

</div>