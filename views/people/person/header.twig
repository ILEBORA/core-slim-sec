<header class="person-header">

    <button class="back-btn">←</button>

    <div class="person-info">
        <h4>{{ person.full_name }}</h4>

        <div class="last-seen">
            {% if person.presence %}
                {% if person.presence.status == 'online' %}
                    Online
                {% elseif person.presence.lastSeen %}
                    Last seen {{ person.presence.lastSeen }}
                {% else %}
                    Offline
                {% endif %}
            {% endif %}
        </div>
    </div>

    <div class="actions">
        {% if person.user_id %}
            
        {% endif %}
    </div>

    {# ⚙️ ACTIONS #}
    <div class="page-actions f-right">

        {# if person.user_id #}
            <button
                class="thread_context_menu"
                data-context-trigger
                data-context-type="person"
                data-context-id="{{ person.id }}"
            >
                ⋮ dd
            </button>
        {# endif #}

    </div>

</header>