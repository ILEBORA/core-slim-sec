<header
    class="person-header"
    data-bind-object="person.{{ person.id }}">

    <button
        class="back-btn"
        data-action="people.back">

        ←

    </button>

    <div class="person-info">

        <h4
            data-field="full_name">

            {{ person.full_name }}

        </h4>

        <div
            data-field="presence"
            data-renderer="presence-text">

            {% if person.presence %}
                {% if person.presence.status == 'online' %}
                    Online
                {% elseif person.presence.lastSeen %}
                    Last seen {{ person.presence.lastSeen }}
                {% else %}
                    Offline
                {% endif %}
            {% endif %}

        </div>

    </div>

    {# ⚙️ ACTIONS #}
    <div class="header-item-actions">

        {# if person.user_id #}
            <button
                class="thread_context_menu"
                data-context-trigger
                data-context-type="person"
                data-context-id="{{ person.id }}"
            >
                ⋮
            </button>
        {# endif #}

    </div>

</header>