{# people/person/profile.twig #}

<div class="person-profile">

    {# ===============================
       AVATAR
    =============================== #}
    <div class="profile-avatar">
        <img src="{{ person.avatar_url }}"
             alt="{{ person.name }}"
             loading="lazy">
    </div>

    {# ===============================
       BASIC INFO
    =============================== #}
    <div class="profile-main">

        <h2 class="profile-name">
            {{ person.name }}
        </h2>

        {% if person.bio %}
            <p class="profile-bio">
                {{ person.bio }}
            </p>
        {% endif %}

        {# STATS #}
        
        <div class="profile-stats">
            {% if person.user_id %}
                <div data-tab="followers">
                    <strong>{{ person.followers_count }}</strong>
                    Followers
                </div>

                <div data-tab="following">
                    <strong>{{ person.following_count }}</strong>
                    Following
                </div>
                {% if person.added_by == current_user_id or person.user_id == current_user_id %}
                    <button class="btn btn-info" data-id="{{ person.id }}" data-action="person:edit">
                        Edit
                    </button>
                {% endif %}
            {% else %}
                <div class="notice">User not Linked</div>
                <button class="btn btn-info" data-id="{{person.id}}" data-action="person:link.invite">Invite</button> 

                {% if person.added_by == current_user_id or person.user_id == current_user_id %}
                    <button class="btn btn-info" data-id="{{ person.id }}" data-action="person:edit">
                        Edit
                    </button>
                {% endif %}
            {% endif %}

            <div class="notice" data-tab="connections">
                <strong>{{ person.connections_count|default('0') }}</strong>
                <span>Connections</span>
            </div>
        </div>

    </div>

    {# ===============================
       META / DETAILS
    =============================== #}
    <div class="profile-meta">

        {% if person.email %}
            <div class="meta-item">
                <span class="label">Email:</span>
                <span class="value">{{ person.email }}</span>
            </div>
        {% endif %}

        {% if person.phone %}
            <div class="meta-item">
                <span class="label">Phone:</span>
                <span class="value">{{ person.phone }}</span>
            </div>
        {% endif %}

        {% if person.location %}
            <div class="meta-item">
                <span class="label">Location:</span>
                <span class="value">{{ person.location }}</span>
            </div>
        {% endif %}

    </div>

    

</div>
{% if person.user_id %}
{# ===============================
    QUICK ACTIONS (OPTIONAL)
=============================== #}
<div class="profile-actions">

    
        {% set followed = person.is_following ? 'followed' : '' %}
        <button class="btn-follow {{ followed }}"
                data-action="people:follow"
                data-person="{{ person.id }}"
                >
            {{ person.is_following ? 'Following' : 'Follow' }}
        </button>

        <button class="btn-follow"
                data-action="people:message"
                data-person="{{ person.id }}">
                Chat
        </button>
    

</div>

{% endif %}