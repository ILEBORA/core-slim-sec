{% if people is empty %}
    <div class="empty-state">
        No results found
    </div>
{% else %}
    {% for person in people %}
        {% set d_state = person.is_deleted ? 'deleted' : '' %}
            {% set fav_state = person.is_favorite ? 'is-fav' : '' %}
            <div class="person-card {{ d_state }}" data-bind-class="is_deleted:deleted"
                    data-person="{{ person.id }}"
                    data-action="people:open"
                    data-type="{{ person.user_id ? 'members' : 'non-users' }}"
                    data-favorite="{{ person.is_favorite ? 1 : 0 }}"

                    data-bind-object="person.{{ person.id }}"
                    >

                <div class="card-actions">
                    <button class="favorite-toggle {{ fav_state }}" data-id="{{ person.id }}"  title="Add to favorites" data-action="act-favorite-toggle">
                        <i class="icon-star"></i>
                    </button>
                </div>

                <div class="avatar">
                    <img 
                        class="lazy personAvatar{{person.id}}" 
                        data-bind="avatar_url"
                        data-bind-attr="src"
                        src="assets/images/icons/noavatar.png" 
                        data-src="{{person.avatar_url}}" 
                    />
                    <span class="status-dot"
                        data-field="presence"
                        data-renderer="presence-dot"></span>
                </div>

                <div class="name" data-field="full_name">
                    {{ person.full_name }}
                </div>

            </div>
    {% endfor %}

{% endif %}