<style>
/* small, reusable styles */
.rating { font-size: 2rem; display: inline-block; user-select: none; }
.rating .star { color: #ccc; cursor: pointer; padding: 0 4px; display: inline-block; }
.rating .star.active { color: #FFD700; } /* gold */
.rating .star:focus { outline: 2px solid #ffa; outline-offset: 2px; }
</style>

<div id="user-input" class="rating" role="radiogroup" aria-label="Rating">
    {% for i in 1..5 %}
        <span class="star" role="radio" aria-checked="false" tabindex="0" data-value="{{ i }}">&#9733;</span>
    {% endfor %}
</div>

<input type="hidden" id="rating-value" name="rating" value="0" />

<script>
/* Load jQuery if your loader supports it. If your app already includes jQuery, change the first argument to null. */
ILEBORA.use('assets/js/jquery.js', function() {
    var $stars = $('#user-input .star');
    var $hidden = $('#rating-value');
    var currentRating = parseInt($hidden.val(), 10) || 0;

    // helper: paint stars up to value
    function paint(value) {
        $stars.each(function() {
            var $s = $(this);
            var v = parseInt($s.data('value'), 10);
            $s.toggleClass('active', v <= value);
            $s.attr('aria-checked', v === value ? 'true' : 'false');
        });
    }

    // initialize
    paint(currentRating);

    // hover preview
    $stars.on('mouseenter', function() {
        var v = parseInt($(this).data('value'), 10);
        paint(v);
    });

    // reset preview to current on mouseleave from container
    $('#user-input').on('mouseleave', function() {
        paint(currentRating);
    });

    // click to set rating
    $stars.on('click', function() {
        currentRating = parseInt($(this).data('value'), 10);
        $hidden.val(currentRating);
        paint(currentRating);
        // optional: trigger an event for other scripts
        $('#user-input').trigger('rating:changed', [currentRating]);
    });

    // keyboard support: Enter/Space to select, Arrow keys to move
    $stars.on('keydown', function(e) {
        var $focused = $(this);
        var v = parseInt($focused.data('value'), 10);

        if (e.key === 'Enter' || e.key === ' ') { // select on Enter/Space
            e.preventDefault();
            $focused.trigger('click');
            $focused.focus();
            return;
        }

        if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
            e.preventDefault();
            var prev = Math.max(1, v - 1);
            $stars.filter('[data-value="' + prev + '"]').focus();
            paint(prev);
            return;
        }

        if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
            e.preventDefault();
            var next = Math.min($stars.length, v + 1);
            $stars.filter('[data-value="' + next + '"]').focus();
            paint(next);
            return;
        }
    });

    // example: using the Send button
    $('#send-btn').off('click.rating').on('click.rating', function(e) {
        e.preventDefault();
        var val = $hidden.val() || 0;
        // replace with your AJAX or form submit logic
        console.log('Selected rating: ' + val);
         manager.handleUserInput(val);
    });
});
</script>

<button id="send-btn" class="btn">Send</button>
