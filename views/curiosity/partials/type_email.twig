
<input 
  type="email" 
  id="user-input" 
  name="{{ name|default('email') }}" 
  placeholder="{{ placeholder|default('Enter your email') }}"
  autocomplete="new-password"
  spellcheck="false"
  autocorrect="off"
  autocapitalize="none"
  value="me@bmail.com"
/>

<button id="send-btn" class="btn">Send</button>
