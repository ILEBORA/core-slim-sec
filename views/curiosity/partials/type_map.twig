<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

<style>
    #user-input {
        height: 300px;
        width: 100%;
    }
</style>

<div id="user-input" class="map-picker"></div>
<button id="send-btn" class="btn">Send</button>

<script>
ILEBORA.use('https://unpkg.com/leaflet/dist/leaflet.js', function(){
    $(function() {
        var map = L.map('user-input').setView([0, 0], 2); // world view

        // add tiles
        // L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        //     attribution: '&copy; OpenStreetMap contributors'
        // }).addTo(map);

        var marker = null;
        var selectedLocation = null;

        // click to drop marker
        map.on('click', function(e) {
            if (marker) {
                map.removeLayer(marker);
            }
            marker = L.marker(e.latlng).addTo(map);
            selectedLocation = {
                lat: e.latlng.lat,
                lng: e.latlng.lng
            };
        });

        // submit
        $('#send-btn').on('click', function(e) {
            e.preventDefault();
            if (!selectedLocation) {
                alert("Please click on the map to pick a location.");
                return;
            }
            manager.handleUserInput(selectedLocation);
        });

        // optional: try to center on user's current location
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function(pos) {
                var lat = pos.coords.latitude;
                var lng = pos.coords.longitude;
                map.setView([lat, lng], 13);
            });
        }

        // in case the container was hidden when initialized
        setTimeout(function() {
            map.invalidateSize();
        }, 500);
    });
});
</script>
