<div id="user-input" class="emoji-picker">
    {% set emojis = [
        { "value": "happy", "char": "😊" },
        { "value": "sad", "char": "😢" },
        { "value": "angry", "char": "😠" },
        { "value": "love", "char": "😍" },
        { "value": "cool", "char": "😎" },
        { "value": "surprised", "char": "😲" }
    ] %}
    
    {% for emoji in emojis %}
        <span class="emoji" data-value="{{ emoji.value }}" style="font-size:2rem; cursor:pointer;">
            {{ emoji.char }}
        </span>
    {% endfor %}
</div>

<button id="send-btn" class="btn">Send</button>

<script>
$(function(){
    var selected = null;

    // click emoji
    $('#user-input .emoji').on('click', function(){
        $('#user-input .emoji').removeClass('selected');
        $(this).addClass('selected');
        selected = $(this).data('value');
    });

    // submit emoji
    $('#send-btn').on('click', function(e){
        e.preventDefault();
        if (!selected) {
            alert("Please pick an emoji first.");
            return;
        }
        manager.handleUserInput(selected);
    });
});
</script>

<style>
#user-input.emoji-picker .emoji {
    margin: 0 .3rem;
    transition: transform 0.2s, box-shadow 0.2s;
}
#user-input.emoji-picker .emoji.selected {
    transform: scale(1.3);
    box-shadow: 0 0 5px #333;
    border-radius: 50%;
    font-size: 3rem !important;
}
</style>
