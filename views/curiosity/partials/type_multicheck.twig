<div id="user-input" class="multicheck">
    {% for opt in options %}
        {% if opt is iterable %}
            {# Case 2: object/assoc array #}
            <label>
                <input type="checkbox" name="items[]" value="{{ opt.value is defined ? opt.value : (opt.id is defined ? opt.id : loop.index) }}">
                {{ opt.label is defined ? opt.label : (opt.name is defined ? opt.name : opt|first) }}
            </label><br>
        {% else %}
            {# Case 1: flat string #}
            <label>
                <input type="checkbox" name="items[]" value="{{ opt|lower }}">
                {{ opt }}
            </label><br>
        {% endif %}
    {% endfor %}
</div>

<button id="send-btn" class="btn">Submit</button>

<script>
$(function() {
    $('#send-btn').on('click', function(e) {
        e.preventDefault();

        // get all checked values
        var values = [];
        $('#user-input input[type="checkbox"]:checked').each(function() {
            values.push($(this).val());
        });

        if (values.length === 0) {
            alert("Please select at least one option.");
            return;
        }

        // pass values array to manager
        manager.handleUserInput(values);
    });
});
</script>