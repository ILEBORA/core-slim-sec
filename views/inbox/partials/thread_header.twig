<header class="thread-header" data-thread="{{ thread.id ?? '' }}">

    {# 🔙 BACK BUTTON #}
    <button class="back-btn"
            aria-label="Back"
            data-action="back">
        ←
    </button>

    {# 🧠 THREAD INFO #}
    <div class="thread-info is-hidden">

        <img
            src="assets/images/icons/placeholder.png"
            data-src="{{ thread.avatar|default('assets/images/icons/placeholder.png') }}"
            alt="Avatar"
            
        >

        <div class="thread-title">

            <h4>
                {{ thread.title ?: thread.display_name ?: 'Conversation' }}
            </h4>

            {% if participants is defined %}
                <div class="participants-count">
                    <span data-bind="thread.participants">
                        {{ participants|length }}
                    </span>
                    participants
                </div>
            {% endif %}

        </div>
    </div>

    {# ⚙️ ACTIONS #}
    <div class="page-actions f-right">

        {% if thread.id is defined %}
            <button
                class="thread_context_menu"
                data-context-trigger
                data-context-type="thread"
                data-context-id="{{ thread.id }}"
            >
                ⋮
            </button>
        {% endif %}

    </div>

</header>