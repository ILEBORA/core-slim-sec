<div class="thread-item 
    {{ thread._has_unread ? 'unread' : '' }}" 
    data-thread="{{ thread.thread_id }}" 
    data-action="thread.open">

    <!-- Avatar -->
    <div class="avatar">
        {% if thread.avatar %}
            <img class="lazy" src="assets/images/icons/noavatar.png" data-src="{{thread.avatar|default('assets/images/icons/noavatar.png')}}" />
        {% endif %}

        {% if thread.is_online %}
            <span class="status-dot"></span>
        {% endif %}
    </div>

    <!-- Meta -->
    <div class="meta">

        {# Title #}
        <div class="title">
            {{ thread.title ?: thread.participants.display_name ?: 'Conversation' }}
        </div>

        {# Preview #}
        <div class="preview">

            {# Sender label #}
            <strong class="sender">
                {% if thread.last_message.sender_id == current_user_id %}
                    You
                {% else %}
                    {{ thread.last_message.sender_name ?? '' }}
                {% endif %}
            </strong>

            {% if thread.last_message.body %}
                <span class="sep">:</span>
            {% endif %}

            {# Message preview #}
            <span class="message">

                {% set type = thread.last_message.type ?? 'text' %}

                {% if type == 'text' %}
                    {{ thread.last_message.body|striptags|slice(0, 50) }}

                {% elseif type == 'media' %}
                    📎 Media

                {% elseif type == 'event' %}
                    📅 Event update

                {% else %}
                    {{ thread.last_message.body|striptags|slice(0, 50) }}
                {% endif %}

            </span>
        </div>

    </div>

    <!-- Stats -->
    <div class="stats">

        <div class="time">
            {{ thread.last_message.created_at|timeago }}
        </div>

        {% if thread.unread_count > 0 %}
            <div class="badge">
                {{ thread.unread_count > 99 ? '99+' : thread.unread_count }}
            </div>
        {% endif %}

    </div>

</div>