{% extends "inbox/inbox.twig" %}

{% block inbox_content %}

{% set view_composer = data_view=='list' ? 'hidden' : '' %}

<div class="thread-view" data-thread="{{ thread_id }}">

    <header class="thread-header">
        <button class="back-btn" aria-label="Back">←</button>
        <div class="thread-info">
            <h4>{{ thread.title ?: thread.display_name }}</h4>

            <div class="participants-count">
                {{ participants|length }} participants
            </div>
        </div>

        <div class="page-actions f-right">
            <button
                data-context-trigger
                data-context-type="thread"
                data-context-id="{{thread.id}}"
                >
                ⋮
            </button>
        </div>
    </header>

    <div class="messages-cont">
        <div class="load-history">
            Load earlier messages
        </div>
        <div class="messages" lvui="inbox_thread_{{ thread_id }}">

            {% if data_view == 'list' %}
                <div class="empty-state">
                    Select a conversation
                </div>
            {% else %}

                {% set previousDate = null %}

                {% for item in messages %}

                    {% if item.type == 'date' %}
                        {{ item.html|raw }}
                    {% endif %}

                    {% if item.type == 'message' %}
                        {{ item.html|raw }}
                    {% endif %}

                {% endfor %}

            {% endif %}

        </div>
    </div>

    <div class="typing-indicator" hidden>
        Someone is typing…
    </div>

    <form class="composer"
          {{ view_composer }}
          action="api/modules/inbox/send-message/{{ thread_id }}"
          data-thread="{{ thread_id }}">

        <input type="text"
               name="body"
               placeholder="Type a message…"
               autocomplete="off">

        <button type="submit">Send</button>
    </form>

</div>

<script>
    window.MAIN_USER_ID = {{ main_id }};
</script>

{% if thread_id is defined %}
<script>
    window.INBOX_THREAD_ID = {{ thread_id }};
    $(function(){
        alert('test');
        $('.thread-item[data-id="{{ thread_id }}"]').addClass('selected');
    });
</script>
{% endif %}


<script>
document.addEventListener('submit', function (e) {
    const form = e.target.closest('.composer');
    if (!form) return;

    e.preventDefault();

    const input = form.querySelector('input[name="body"]');
    const body = input.value.trim();
    if (!body) return;

    fetch(form.action, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ body })
    })
    .then(async r => {
        const text = await r.text();
        if (!text) throw new Error('Empty response');
        return JSON.parse(text);
    })
    .then(res => {
        if (!res.success) {
            alert('Message failed to send');
            return;
        }
        input.value = '';
    })
    .catch(err => {
        console.error(err);
        alert('Network error');
    });
});


appHooks.addHook('realtime:inbox:thread:{{ thread_id }}', e => {
    alert('there');
    console.log('realtime:inbox:user:{{ main_id }}');
    if (e.type === 'message.sent') {
        appInbox.appendMessage(e, {
            isMe: e.sender_id === window.MAIN_USER_ID
        });
    }

    if (e.type === 'typing.start') {
        appInbox.showTyping();
    }

    if (e.type === 'typing.stop') {
        appInbox.hideTyping();
    }
});

appHooks.addHook('realtime:inbox:user:{{ main_id }}', e => {
    console.log('realtime:inbox:user:{{ main_id }}');
    //alert('here');
    if (e.type === 'thread.reordered') {
        appInbox.bumpThread(e.thread_id);
    }
});

let typingTimer = null;

const form  = document.querySelector('.composer');
const input = form?.querySelector('input[name="body"]');

if (input && window.INBOX_THREAD_ID) {

    input.addEventListener('input', () => {

        // Tell backend: typing started
        fetch(`api/modules/inbox/typing-start/${window.INBOX_THREAD_ID}`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        });

        clearTimeout(typingTimer);

        typingTimer = setTimeout(() => {
            // Tell backend: typing stopped
            fetch(`api/modules/inbox/typing-stop/${window.INBOX_THREAD_ID}`, {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
        }, 1200);
    });

}

</script>

{% endblock %}

