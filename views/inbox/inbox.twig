<div class="inbox-layout inbox"
     data-view="{{ data_view|default('list') }}">

    {{ lvui|raw }}

    {# ===============================
       SIDEBAR
    =============================== #}
    <aside class="inbox-sidebar">

        <div class="inbox-header">
            <span><h3>{{__t('inbox.title.inbox',null,'Inbox')}}</h3></span>
            <button class="new-thread-btn" title="{{__t('inbox.tip.new.chat',null,'New chat')}}">+</button>
        </div>

        <div class="thread-search">
            <input
                type="search"
                placeholder="{{__t('inbox.search.conversations', null, 'Search conversations')}}…"
                aria-label="Search inbox"
                data-inbox-search
            >

            <button
                class="filter-unread"
                aria-pressed="false"
                title="{{__t('inbox.tip.show.unread', null, 'Show unread only')}}"
                data-inbox-filter="unread">
                ●
            </button>
        </div>

        <div class="thread-filters">
            <button data-type="all" class="active">{{__t('inbox.filter.all', null, 'All')}}</button>
            <button data-type="chat">{{__t('inbox.filter.direct', null, 'Direct')}}</button>
            <button data-type="group">{{__t('inbox.filter.groups', null, 'Groups')}}</button>
        </div>

        <ul class="thread-list" lvui="inbox_threads">

            {% for thread in threads %}
                <li class="thread-item {{ thread.unread_count ? 'unread' : '' }}"
                    data-thread="{{ thread.thread_id }}"
                    data-type="{{ thread.thread_type ?? 'direct' }}"
                    >

                    <div class="avatar">
                        <img class="lazy" src="assets/images/icons/noavatar.png" data-src="{{thread.avatar|default('assets/images/icons/noavatar.png')}}" />
                        <span class="status-dot online"></span>
                    </div>

                    <div class="meta">
                        <div class="title">
                            {{ thread.title ?: thread.display_name}}
                        </div>

                        <div class="preview">
                            {{ thread.last_message_body|raw|default('No messages yet') }}
                        </div>
                    </div>

                    <div class="stats">
                        {% if thread.unread_count %}
                            <span class="badge">
                                {{ thread.unread_count }}
                            </span>
                        {% endif %}

                        <time>
                            {{ thread.last_message_at|date('H:i') }}
                        </time>
                    </div>
                </li>
            {% endfor %}

        </ul>
    </aside>


    {# ===============================
       MAIN CONTENT
    =============================== #}
    <main class="inbox-content">

        {% block inbox_content %}
            {# thread view #}
        {% endblock %}

    </main>


    {# ===============================
       FLOATING ACTION BUTTON
    =============================== #}
    <button
        class="fab-new-thread"
        aria-label="New conversation"
        title="{{__t('inbox.tip.new.conversation', null, 'New conversation')}}"
        >
        +
    </button>


    {# ===============================
       NEW CONVERSATION SHEET
    =============================== #}
    <div class="inbox-composer" hidden>

        <div class="composer-backdrop"></div>

        <div class="composer-sheet">

            <header>
                <h4>New conversation</h4>
                <button class="close" data-action="inbox:close-composer">
                    ×
                </button>
            </header>

            <div class="composer-body">

                <input
                    type="search"
                    class="participant-search"
                    placeholder="Search people…"
                    autocomplete="off"
                    data-inbox-participant-search
                >

                <ul class="participant-results">
                    {# dynamically injected by plugin #}
                </ul>

            </div>

            <footer>
                <button class="start-btn"
                        disabled
                        data-action="inbox:confirm-start">
                    Start
                </button>
            </footer>

        </div>

    </div>

</div>
