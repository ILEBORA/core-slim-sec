<style>
.grid-pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem 0;
}

.pagination-controls a {
  padding: 0.4rem 0.75rem;
  border: 1px solid #ddd;
  margin: 0 0.2rem;
  border-radius: 4px;
  text-decoration: none;
}

.pagination-controls a.active, .pagination-controls button.active {
  background-color: #007bff;
  color: #fff;
  border-color: #007bff;
}
</style>
<script type='text/javascript' src='https://cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js'></script>
<script>


</script>
{% if data.pagination is defined %}
  {% set p = data.pagination %}
  <div class="grid-pagination" data-page="{{ p.current_page }}">
    <div class="pagination-summary">
      {{  grid.id }}  
      {% set start = ((p.current_page - 1) * p.per_page) + 1 %}
      {% set end = (p.current_page * p.per_page) > p.total ? p.total : (p.current_page * p.per_page) %}
      Showing {{ start }} - {{ end }} of {{ p.total }} entries
    </div>

    <div class="pagination-controls" data-grid-unique="{{config.unique}}" data-grid-type="{{ gridType }}">
      {% if p.current_page > 1 %}
        <button class="page-btn page-prev" data-page="{{ p.current_page - 1 }}" data-grid-page="{{ p.current_page - 1 }}" data-grid-id="{{ grid.id|default('0') }}" >&laquo; Prev</button>
      {% endif %}

      {% for i in 1..p.last_page %}
        <button class="page-btn page-num {{ i == p.current_page ? 'active' : '' }}" data-page="{{ i }}"  data-grid-id="{{ grid.id|default('0') }}">{{ i }}</button>
      {% endfor %}

      {% if p.current_page < p.last_page %}
        <button class="page-btn page-next" data-page="{{ p.current_page + 1 }}"  data-grid-id="{{ grid.id|default('0') }}">Next &raquo;</button>
      {% endif %}
    </div>
  </div>
{% endif %}


