<div id="{{ id }}" class="about_inf_block">

    <div class="about_inf_title">
        <span>{{ title }}</span>

        <a
            title="Edit"
            class="edit_link"
            onclick="return false;"
            style="display:none;">
        </a>
    </div>

    <div class="about_inf_cont">
        <div class="about_info_box">
            {{ content|safehtml }}
        </div>
    </div>

</div>