{# -------------------------------------------
   ROOT MENU ITEM TEMPLATE
   item: { id, label, route, icon, sort_order, permission_key }
--------------------------------------------- #}

<li class="features-item root-item"
    data-menu-id="{{ item.id }}"
    data-url="{{ item.route }}"
    data-label="{{ item.label }}"
    data-target="{{ item.target_key }}"
    onclick="appUI.sideBar.handleClick(this)">

    {# Icon if available #}
    {% if item.icon %}
        <i class="menu-icon {{ item.icon }}"></i>
    {% else %}
        <i class="menu-icon fa fa-circle"></i>
    {% endif %}
    
    <span class="label">{{ item.title }}</span>
    
    <i id="menu_loading_{{ item.target_key }}" class="menu_loading"></i>

    <i class="badge page-items-badges page-item-badge_{{ item.target_key }} badge-warning top-bar-icons-badge"></i>

    {# Indicator for children (expand toggle) #}
    {% if item.has_children %}
        <i class="fa fa-chevron-right toggle-arrow"></i>
    {% endif %}
</li>

{# Optional container for children (loaded separately) #}
{% if item.has_children %}
<ul class="submenu submenu-{{ item.id }}" style="display:none;"></ul>
{% endif %}