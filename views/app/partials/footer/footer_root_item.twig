<li class="header-item" 
    data-url="{{ item.url }}"
    data-label="{{ item.label }}">
   <a class="sb_{{ label }} {{class}}" {{ attributes|raw }} onclick="appUI.content.loadPage('{{item.url}}')">
       {% if item.icon %}
       <i class="{{ item.icon }}"></i>
       {% endif %}
       {{ item.title }}
   </a>
</li>