<li class="header-item" data-url="{{ item.url }}"
    data-label="{{ item.label }}">
   <a href="{{ item.url }}">
       {% if item.icon %}
       <i class="{{ item.icon }}"></i>
       {% endif %}
       {{ __t(item.menu_key,null,item.title) }}
   </a>
   <i id="menu_loading_{{ item.id }}" class="menu_loading"></i>
</li>