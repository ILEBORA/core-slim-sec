{% for item in menus.roots %}
    <li class="features-item"
        data-url="{{ item.route }}"
        data-label="{{ item.label }}"
        onclick="appUI.sideBar.handleClick(this);">
        <span class="label">{{ item.label }}</span>
        <i id="menu_loading_{{ item.label }}" class="menu_loading"></i>
    </li>

    {% if menus.children[item.id] is defined %}
        <ul class="submenu">
            {% for child in menus.children[item.id] %}
                <li class="features-item child"
                    data-url="{{ child.route }}"
                    data-label="{{ child.label }}"
                    onclick="appUI.sideBar.handleClick(this);">
                    <span class="label">{{ child.label }}</span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endfor %}