<section class="submenu-area">
        <div id="injectSub" class="container sub_menu animated" style="display: block;">
            {% block submenus %}
                {{submenus|raw}}
            {% endblock %}
        </div> 
        <div id="injectSubChild" class="container sub_menu_child" style="display: block;">
            {% block subchildmenus %}
                {{subchildmenus|raw}}
            {% endblock %}
        </div> 
</section>