<style>
#android-add-hint {
    position: fixed;
    bottom: -150px;
    left: 50%;
    transform: translateX(-50%);
    width: 92%;
    background: rgba(33,33,33,0.95);
    border-radius: 18px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.35);
    text-align: center;
    font-size: 15px;
    color: #fff;
    padding: 14px 16px;
    line-height: 1.4;
    z-index: 99999;
    backdrop-filter: blur(4px);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    opacity: 0;
    pointer-events: none;
    transition: all 0.6s cubic-bezier(0.25, 1, 0.5, 1);
}

#android-add-hint.visible {
    bottom: 15px;
    opacity: 1;
    pointer-events: auto;
}

#android-add-hint button {
    margin-top: 10px;
    background: #00c853;
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 6px 14px;
    font-size: 14px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.3);
    cursor: pointer;
    transition: background 0.3s;
}

#android-add-hint button:hover {
    background: #00b24a;
}
</style>

<div id="android-add-hint">
    <div style="margin-bottom:6px;font-weight:600;">
        🌟 Install <span style="color:#00e676;">IleBora</span> for a better experience
    </div>
    <div style="font-size:14px;">
        Access it instantly — no browser needed!
    </div>
    <div style="display:flex;justify-content:center;gap:10px;margin-top:10px;">
        <button id="android-install-btn">Install</button>
        <button id="android-dismiss-btn" style="background:#555;">Maybe later</button>
    </div>
</div>

<script>
(function(){
    const hint = document.getElementById('android-add-hint');
    let deferredPrompt = null;

    window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;

        if(localStorage.getItem('android_hint_dismissed') === '1') return;

        setTimeout(() => hint.classList.add('visible'), 800);
    });

    document.getElementById('android-install-btn')?.addEventListener('click', async () => {
        if(!deferredPrompt) return;
        deferredPrompt.prompt();
        const choice = await deferredPrompt.userChoice;
        if(choice.outcome === 'accepted'){
            hint.classList.remove('visible');
            localStorage.setItem('android_hint_dismissed', '1');
        }
        deferredPrompt = null;
    });

    document.getElementById('android-dismiss-btn')?.addEventListener('click', () => {
        localStorage.setItem('android_hint_dismissed', '1');
        hint.classList.remove('visible');
        setTimeout(() => hint.style.display = 'none', 500);
    });

    window.addEventListener('appinstalled', () => {
        localStorage.setItem('android_hint_dismissed', '1');
        hint.classList.remove('visible');
    });
})();
</script>
