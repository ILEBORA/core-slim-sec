<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="theme-color" content="#0057ff">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Launching IleBora App...</title>
  <base href="{{ baseUrl }}">
  <link rel="manifest" href="{{ baseUrl }}manifest.json">
  <style>
    body {
      font-family: system-ui, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      height: 100vh;
      background: #f5f7ff;
      color: #333;
      text-align: center;
    }
    h2 {
      margin-bottom: 0.2em;
    }
    button {
      background: #0057ff;
      color: white;
      padding: 12px 22px;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      cursor: pointer;
      margin-top: 1em;
      box-shadow: 0 3px 8px rgba(0, 87, 255, 0.3);
    }
    #installPrompt {
      display: none;
      animation: fadeIn 0.3s ease-in-out;
    }
    @keyframes fadeIn {
      from {opacity: 0; transform: translateY(10px);}
      to {opacity: 1; transform: translateY(0);}
    }
  </style>
</head>
<body>
  <h2>Opening the IleBora App...</h2>
  <p>If it doesn't open automatically, tap below:</p>

  <button id="openAppBtn">Open IleBora</button>
  <div id="installPrompt">
    <p>Want quick access? Install the IleBora App!</p>
    <button id="installBtn">Install App</button>
  </div>

  <script>
    const appURL = '{{ baseUrl|default('https://ilebora.co.ke/') }}?utm_source=launcher';
    const isStandalone =
      window.matchMedia('(display-mode: standalone)').matches ||
      window.navigator.standalone;

    // 🔹 Auto open if installed
    if (isStandalone) {
      window.location.href = appURL;
    } else {
      // Try to open automatically
      setTimeout(() => {
        window.location.href = appURL;
      }, 20000);
    }

    document.getElementById('openAppBtn').onclick = () => {
      window.location.href = appURL;
    };

    // 🔹 Handle Pwa install prompt
    let deferredPrompt;
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      document.getElementById('installPrompt').style.display = 'block';
    });

    document.getElementById('installBtn').onclick = async () => {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        const choice = await deferredPrompt.userChoice;
        if (choice.outcome === 'accepted') {
          document.getElementById('installPrompt').innerHTML =
            '<p>Installing... you can now access IleBora like an app!</p>';
        }
        deferredPrompt = null;
      } else if (navigator.standalone) {
        alert('App is already installed.');
      } else {
        alert('Use your browser menu → "Add to Home Screen" to install.');
      }
    };
  </script>
</body>
</html>
