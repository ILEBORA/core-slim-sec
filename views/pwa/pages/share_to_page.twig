<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Share to IleBora</title>
<base href="{{ baseUrl }}">
<style>
  body { font-family: system-ui; padding: 1em; }
  .user-list { margin-top: 1em; }
  .user { padding: .75em; margin-bottom: .5em; border: 1px solid #ddd; border-radius: 8px; cursor: pointer; }
  .user:hover { background: #f0f5ff; }
  img { max-width: 100px; margin-top: 10px; border-radius: 6px; }
</style>
</head>
<body>
<h2>Share to IleBora</h2>
<p id="preview"></p>
<div id="mediaPreview"></div>

<h3>Select Recipient</h3>
<div id="userList" class="user-list"></div>

<script>
const params = new URLSearchParams(location.search);
const text = params.get("text") || "";
const title = params.get("title") || "";
const file = params.get("file");

document.getElementById("preview").textContent = text || title;
if (file) {
  const img = document.createElement("img");
  img.src = file;
  document.getElementById("mediaPreview").appendChild(img);
}

// Simulate fetching IleBora contacts
const contacts = [
  { id: 1, name: "Admin" },
  { id: 2, name: "Customer Care" },
  { id: 3, name: "Support Bot" },
];

const userList = document.getElementById("userList");
contacts.forEach(user => {
  const div = document.createElement("div");
  div.className = "user";
  div.textContent = user.name;
  div.onclick = () => sendToUser(user.id);
  userList.appendChild(div);
});

function sendToUser(userId) {
  const payload = { userId, text, title, file };
  fetch("{{baseUrl}}api/share-to-user", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload)
  }).then(res => res.json())
    .then(r => {
      alert("Shared to " + r.username + " successfully!");
      window.location.href = "{{baseUrl}}chat?user=" + userId;
    });
}
</script>
</body>
</html>