<h2>Error Logs</h2>

<form id="logForm" method="get">

    <div class="log-toolbar">

        <select name="date" onchange="this.form.submit()">

            {% for file in files %}

                {% set name = file|split('/')|last|replace({'errors-':'','.log':''}) %}

                <option value="{{ name }}"
                    {{ name == date ? 'selected' : '' }}>
                    {{ name }}
                </option>

            {% endfor %}

        </select>

        <button type="button" id="refreshLogs">
            🔄 Refresh
        </button>

        <button type="button" id="clearLogs">
            🗑 Clear
        </button>

        <label>
            <input type="checkbox" id="autoRefresh">
            Auto Sync
        </label>

    </div>

</form>

<pre class="log-viewer">{{ content|raw }}</pre>

<script>
let timer = null;

$('#refreshLogs').on('click', function () {
    location.reload();
});

$('#autoRefresh').on('change', function () {

    if (this.checked) {

        timer = setInterval(() => {
            location.reload();
        }, 3000);

    } else {

        clearInterval(timer);

    }

});

$('#clearLogs').on('click', function () {

    if (!confirm('Clear current log file?')) {
        return;
    }

    $.post('api/modules/system/developer/logsclear', {
        date: $('select[name=date]').val()
    }, function () {

        //location.reload();

    });

});
</script>