<div class="seed-admin-detail seed-performance-detail container">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="seed-detail-header">

        <div class="seed-detail-heading">

            <div class="seed-detail-icon">
                <i class="fa fa-chart-line"></i>
            </div>

            <div>

                <div class="seed-detail-eyebrow">
                    Seed Intelligence
                </div>

                <h1>
                    Performance
                </h1>

                <div class="seed-detail-subtitle">
                    Measure seed activity, task execution and user impact.
                </div>

            </div>

        </div>


        <div class="seed-detail-actions">

            <a
                href="bo/seed"
                data-nav="bo/seed"
                class="seed-btn seed-btn-secondary"
            >
                <i class="fa fa-dashboard"></i>
                Dashboard
            </a>

            <a
                href="bo/seed/tasks"
                data-nav="bo/seed/tasks"
                class="seed-btn seed-btn-secondary"
            >
                <i class="fa fa-tasks"></i>
                Tasks
            </a>

        </div>

    </div>


    <!-- =====================================================
         PERIOD
         ===================================================== -->

    <div class="seed-performance-toolbar">

        <div>

            <span class="seed-panel-eyebrow">
                Reporting period
            </span>

            <strong>
                {{ period.label|default('Current period') }}
            </strong>

        </div>

        <div class="seed-performance-periods">

            <button
                type="button"
                class="seed-period active"
                data-action="seed.performance.period"
                data-period="7d"
            >
                7 days
            </button>

            <button
                type="button"
                class="seed-period"
                data-action="seed.performance.period"
                data-period="30d"
            >
                30 days
            </button>

            <button
                type="button"
                class="seed-period"
                data-action="seed.performance.period"
                data-period="90d"
            >
                90 days
            </button>

        </div>

    </div>


    <!-- =====================================================
         PRIMARY KPIs
         ===================================================== -->

    <div class="seed-dashboard-stats">

        <div class="seed-dashboard-stat">

            <div class="seed-dashboard-stat-icon">
                <i class="fa fa-tasks"></i>
            </div>

            <div>

                <span>
                    Tasks Executed
                </span>

                <strong>
                    {{ performance.tasks_executed|default(0) }}
                </strong>

                <small>
                    {{ performance.task_completion_rate|default(0) }}%
                    completion
                </small>

            </div>

        </div>


        <div class="seed-dashboard-stat">

            <div class="seed-dashboard-stat-icon">
                <i class="fa fa-comments"></i>
            </div>

            <div>

                <span>
                    Seed Interactions
                </span>

                <strong>
                    {{ performance.interactions|default(0) }}
                </strong>

                <small>
                    comments / replies
                </small>

            </div>

        </div>


        <div class="seed-dashboard-stat">

            <div class="seed-dashboard-stat-icon">
                <i class="fa fa-users"></i>
            </div>

            <div>

                <span>
                    User Responses
                </span>

                <strong>
                    {{ performance.user_responses|default(0) }}
                </strong>

                <small>
                    responses following seeds
                </small>

            </div>

        </div>


        <div class="seed-dashboard-stat">

            <div class="seed-dashboard-stat-icon">
                <i class="fa fa-line-chart"></i>
            </div>

            <div>

                <span>
                    Engagement Lift
                </span>

                <strong>
                    {{ performance.engagement_lift|default(0) }}%
                </strong>

                <small>
                    attributed improvement
                </small>

            </div>

        </div>

    </div>


    <div class="seed-detail-grid">


        <!-- =================================================
             OBJECTIVE PERFORMANCE
             ================================================= -->

        <section class="seed-panel seed-panel-wide">

            <div class="seed-panel-header">

                <div>

                    <span class="seed-panel-eyebrow">
                        Strategy
                    </span>

                    <h2>
                        Objective Performance
                    </h2>

                </div>

            </div>


            {% if objectives is defined and objectives|length %}

                <div class="seed-performance-objectives">

                    {% for objective in objectives %}

                        <div class="seed-performance-objective">

                            <div class="seed-performance-objective-heading">

                                <div>

                                    <strong>
                                        {{ objective.name }}
                                    </strong>

                                    <small>
                                        {{ objective.metric|default('No primary metric') }}
                                    </small>

                                </div>

                                <strong>
                                    {{ objective.success_rate|default(0) }}%
                                </strong>

                            </div>


                            <div class="seed-progress">

                                <div
                                    class="seed-progress-bar"
                                    style="width: {{ objective.success_rate|default(0) }}%;"
                                ></div>

                            </div>


                            <div class="seed-performance-objective-meta">

                                <span>
                                    {{ objective.tasks|default(0) }}
                                    tasks
                                </span>

                                <span>
                                    {{ objective.completed|default(0) }}
                                    completed
                                </span>

                                <span>
                                    {{ objective.results|default(0) }}
                                    results
                                </span>

                            </div>

                        </div>

                    {% endfor %}

                </div>

            {% else %}

                <div class="seed-empty">
                    No objective performance data available.
                </div>

            {% endif %}

        </section>


        <!-- =================================================
             PERSONA PERFORMANCE
             ================================================= -->

        <section class="seed-panel">

            <div class="seed-panel-header">

                <div>

                    <span class="seed-panel-eyebrow">
                        People
                    </span>

                    <h2>
                        Persona Performance
                    </h2>

                </div>

                <a
                    href="bo/seed/personas"
                    data-nav="bo/seed/personas"
                    class="seed-panel-link"
                >
                    View
                </a>

            </div>


            {% if personas is defined and personas|length %}

                <div class="seed-persona-performance">

                    {% for persona in personas %}

                        <a
                            href="bo/seed/persona/{{ persona.id }}"
                            data-nav="bo/seed/persona/{{ persona.id }}"
                            class="seed-persona-performance-row"
                        >

                            <div class="seed-avatar">
                                <i class="fa fa-user"></i>
                            </div>

                            <div>

                                <strong>
                                    {{ persona.name|default(persona.key) }}
                                </strong>

                                <small>
                                    {{ persona.tasks|default(0) }}
                                    tasks
                                </small>

                            </div>

                            <strong>
                                {{ persona.success_rate|default(0) }}%
                            </strong>

                        </a>

                    {% endfor %}

                </div>

            {% else %}

                <div class="seed-empty">
                    No persona data available.
                </div>

            {% endif %}

        </section>


        <!-- =================================================
             METRICS
             ================================================= -->

        <section class="seed-panel">

            <div class="seed-panel-header">

                <div>

                    <span class="seed-panel-eyebrow">
                        Measurement
                    </span>

                    <h2>
                        Key Metrics
                    </h2>

                </div>

            </div>


            {% if metrics is defined and metrics|length %}

                <div class="seed-metric-list">

                    {% for metric in metrics %}

                        <div class="seed-metric">

                            <div class="seed-metric-main">

                                <span class="seed-metric-icon">
                                    <i class="fa fa-chart-bar"></i>
                                </span>

                                <div>

                                    <strong>
                                        {{ metric.name|default(metric.metric) }}
                                    </strong>

                                    <small>
                                        {{ metric.description|default('') }}
                                    </small>

                                </div>

                            </div>

                            <div class="seed-metric-weight">

                                <strong>
                                    {{ metric.value|default(0) }}
                                </strong>

                            </div>

                        </div>

                    {% endfor %}

                </div>

            {% else %}

                <div class="seed-empty">
                    No performance metrics recorded.
                </div>

            {% endif %}

        </section>


        <!-- =================================================
             RECENT RESULTS
             ================================================= -->

        <section class="seed-panel seed-panel-wide">

            <div class="seed-panel-header">

                <div>

                    <span class="seed-panel-eyebrow">
                        Measurement History
                    </span>

                    <h2>
                        Recent Results
                    </h2>

                </div>

            </div>


            {% if results is defined and results|length %}

                <div class="seed-result-list">

                    {% for result in results %}

                        <div class="seed-result">

                            <div>

                                <strong>
                                    {{ result.metric }}
                                </strong>

                                <small>
                                    {{ result.measured_at }}
                                </small>

                            </div>

                            <strong class="seed-result-value">
                                {{ result.value }}
                            </strong>

                        </div>

                    {% endfor %}

                </div>

            {% else %}

                <div class="seed-empty">
                    No performance results have been recorded yet.
                </div>

            {% endif %}

        </section>

    </div>

</div>