<bora-lvui
    class="{{ class }} {{ lvui }}"
    blvui="{{ lvui }}"
    data-id="LiveAcc"
    pointer
>
    {{ count }}
</bora-lvui>

<style>
/* ---------------------------------------------
   LVUI base / follower / leader styling
--------------------------------------------- */

.realtime_class{
    width: 20px;
    font-size: small;
    float: right;
    background: #ccc;
    color: #000;
    text-align: center;
}

bora-lvui.realtime_class.realtime-follower {
    background: #ccc;
    color: #000;
}

bora-lvui.realtime_class.realtime-leader {
    background: #4caf50;
    color: #fff;
    box-shadow: 0 0 0 2px rgba(76,175,80,0.4);
    transition: background 0.3s ease;
}

/* ---------------------------------------------
   Realtime Debug Overlay
--------------------------------------------- */

#realtime-debug-overlay{
    position: fixed;
    right: 10px;
    bottom: 10px;
    width: 220px;
    font: 12px monospace;
    background: #1e1e1e;
    color: #eee;
    border-radius: 6px;
    padding: 10px;
    z-index: 99999;
    box-shadow: 0 8px 30px rgba(0,0,0,.4);
}

#realtime-debug-overlay.rt-leader {
    border-left: 6px solid #4caf50;
}

#realtime-debug-overlay .rt-header {
    color: #4caf50;
    font-weight: bold;
    margin-bottom: 6px;
}

#realtime-debug-overlay .rt-row {
    margin-bottom: 4px;
}

#realtime-debug-overlay button {
    background: #333;
    color: #fff;
    border: 0;
    padding: 4px 8px;
    cursor: pointer;
}

#realtime-debug-overlay button:hover {
    background: #555;
}
</style>

<script>
window.REALTIME_DEBUG = false; // disable in prod
</script>


<script>
$(function () {

    const app = window.__BORA_APP__;
    const leader = await app?.service('realtime.leader');
    const sse = await app?.service('realtime.sse');
    leader.start();
    console.log('Leader::',leader);
    if (!leader || !sse) return;

    function startSSEIfLeader() {

        if (!leader.isLeader()) return;

        sse._raw?.closeConnecton?.(); // if needed

        sse.subscribe({
            id: "{{ id|default('') }}",
            userID: "{{ userID|default('') }}",
            sessionID: "{{ sessionID|default('') }}",
            event: "{{ event|default('updatesmain') }}",
            timer: {{ timer|default(20) }},
            base: "{{ baseURL|default('') }}",
            leaderEpoch: leader.getEpoch()
        });
    }

    app.on('realtime:leader-change', ({ isLeader }) => {
        if (isLeader) {
            startSSEIfLeader();
        }else {
            sse.closeConnection();
        }
    });

    if (leader.isLeader()) {
        startSSEIfLeader();
    }

});
</script>


<script>
$(function () {
    const $lvui = $('bora-lvui[blvui]');
    if (!$lvui.length) return;

    const app = window.__BORA_APP__;
    const leader = await app?.service('realtime.leader');

    if (!leader) return;

    function apply(isLeader) {
        $lvui
            .toggleClass('realtime-leader', isLeader)
            .toggleClass('realtime-follower', !isLeader);
    }

    function applyState() {
        apply(leader.isLeader());
    }

    applyState();

    app.on('realtime:leader-change', ({ isLeader }) => {
        apply(isLeader);
    });
});
</script>

<script>
(function () {
    if (!window.__BORA_APP__) return;
    if (!window.REALTIME_DEBUG) return;

    const el = document.createElement('div');
    el.id = 'realtime-debug-overlay';
    el.innerHTML = `
        <div class="rt-header">Realtime Debug</div>
        <div class="rt-row"><b>Tab</b>: <span data-tab></span></div>
        <div class="rt-row"><b>Leader</b>: <span data-leader></span></div>
        <div class="rt-row"><b>Epoch</b>: <span data-epoch></span></div>
        <div class="rt-row"><b>SSE</b>: <span data-sse></span></div>
        <div class="rt-actions">
            <button data-force>Force Leader</button>
        </div>
    `;

    // ✅ Insert after .main-wrapper (not at end of body)
    const anchor = document.querySelector('.main-wrapper');

    if (anchor && anchor.parentNode) {
        anchor.parentNode.insertBefore(el, anchor.nextSibling);
    } else {
        console.warn('[RealtimeDebug] .main-wrapper not found, appending to body');
        document.body.appendChild(el);
    }

    const $tab    = el.querySelector('[data-tab]');
    const $leader = el.querySelector('[data-leader]');
    const $epoch  = el.querySelector('[data-epoch]');
    const $sse    = el.querySelector('[data-sse]');
    const $force  = el.querySelector('[data-force]');

    function refresh() {
        const app = window.__BORA_APP__;
        const leader = await app?.service('realtime.leader');
        const sse = await app?.service('realtime.sse');

        const isL = leader?.isLeader();
        $tab.textContent = leader?.getTabId?.() || '—';
        $epoch.textContent = leader?.getEpoch?.() ?? '—';
        $sse.textContent = sse?._raw?.ths_source ? 'CONNECTED' : 'IDLE';

        el.classList.toggle('rt-leader', !!isL);
    }

    refresh();
    app.on('realtime:leader-change', refresh);

    $force.onclick = () => {
        if (!window.tryBecomeLeader) return;
        localStorage.removeItem('sse-leader-lock');
        setTimeout(refresh, 300);
    };

    setInterval(refresh, 2000);

    function insertAfterMainWrapper(el) {
        const anchor = document.querySelector('.main-wrapper');
        if (!anchor) return false;

        anchor.parentNode.insertBefore(el, anchor.nextSibling);
        return true;
    }

    if (!insertAfterMainWrapper(el)) {
        const obs = new MutationObserver(() => {
            if (insertAfterMainWrapper(el)) {
                obs.disconnect();
            }
        });

        obs.observe(document.body, { childList: true });
    }

})();
</script>
