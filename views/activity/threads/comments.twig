<div class="activity-thread" data-id="{{ activityId }}" data-parent="{{parent_id}}">

    {# Activity summary (hydrated via JS) #}
    <div id="threadActivity" class="activity-entry"></div>

    {# Comment composer #}
    <div class="thread-composer">
        <textarea
            id="threadCommentBody"
            placeholder="Post your reply">
        </textarea>
        <button id="thread.send.comment" class="btn btn-success space_left">
            Reply
        </button>
    </div>

    {# Comments list #}
    <div id="threadComments" class="thread-comments"></div>

</div>

