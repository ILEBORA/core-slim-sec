<div class="media_preview">
{% if media.type == 'image' %}
    <img class="lazy" src2="assets/images/icons/placeholder.png" 
        style="width:100%;height:100%;" 
        src="viewer/media/{{ media.media_id }}/t?t={{media.updated_at}}"
        data-src="viewer/media/{{ media.media_id }}?t={{media.updated_at}}">
    <script>$(function(){lazyLoad();})</script>
{% elseif media.type == 'video' or media.type == 'mp4' %}
    <video controls preload="metadata">
        <source src="viewer/media/{{ media.media_id }}?t={{media.updated_at}}" type="video/mp4">
    </video>

{% else %}
    <center>Preview not allowed.</center>
{% endif %}
</div>