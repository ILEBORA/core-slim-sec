<div class="media_preview">
{% if media.type == 'image' %}
    <img class="lazy" src="assets/images/icons/placeholder.png" style="width:100%;height:100%;" data-src="{{ media.preview_path }}">
    <script>$(function(){lazyLoad();})</script>
{% elseif media.type == 'video' %}
    <video controls preload="metadata">
        <source src="{{ media.preview_path }}" type="video/mp4">
    </video>
{% endif %}
</div>