<div class="activity-thread" data-activity="{{ id }}">

    {# Activity summary (hydrated via JS) #}
    <div id="threadActivity" class="activity-entry"></div>

    {# Comment composer #}
    <div class="thread-composer">
        <textarea
            id="threadCommentBody"
            class="input-placeholder"
            placeholder="Post your reply"></textarea>

        <button id="threadSendComment" class="btn btn-success space_left">
            Reply
        </button>
    </div>

    {# Comments list #}
    <div id="threadComments" class="thread-comments"></div>

</div>

<script>
$(async function(){
    
    const thread = await window.__BORA_APP__?.plugin?.('activity.thread');
    if (!thread) return;
    thread.init();
    
    const ctx = window.__diagContext || {};

    if (ctx.state?.focus === 'composer') {
        $('#threadCommentBody').focus();
    }
})
</script>