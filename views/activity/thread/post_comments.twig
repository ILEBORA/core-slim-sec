<div class="activity-thread" data-id="{{ item.item.id }}" data-parent="{{ item.item.parent_id }}">

    {# Activity summary (hydrated via JS) #}
    <div id="threadActivity" class="activity-entry">
        {{ item.html|raw }}
    </div>

    {# Comment composer #}
    <div class="thread-composer">
        <div id="mention-menu" class="mention-menu"></div>
        <textarea
            id="threadCommentBody"
            class="input-placeholder"
            placeholder="{{ __t('activity.placeholder.write_reply', null, 'Post your reply') }}"></textarea>

        <button data-action="thread.send.comment" class="btn btn-success space_left">
            {{ __t('activity.label.reply', null, 'Reply') }}
        </button>
    </div>

    {# Comments list #}
    <div id="threadComments" class="thread-comments">
        <center><img src="assets/images/icons/ajax.gif"/></center>
    </div>

</div>

<script>
$(async function(){
    
    const thread = await window.__BORA_APP__?.plugin?.('activity.thread');
    if (!thread) return;
    thread.init({{ item.item.id }});
    
    const ctx = window.__diagContext || {};

    if (ctx.state?.focus === 'composer') {
        $('#threadCommentBody').focus();
    }
})

$(async function(){
    const gateway= await window.__BORA_APP__.getPlugin('activity.composer');
    gateway.init();
});
</script>