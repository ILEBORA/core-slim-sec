<div class="comment-item" data-id="{{ item.id }}" style="">
    <div class="comment-avatar" data-nav="portal/people/person/{{ item._actor.person_id }}/view">
        <img src="{{ item._actor.avatar_url|default('assets/images/icons/noavatar.png') }}">
    </div>

    <div class="comment-body">
        <div class="comment-meta">
            <strong data-nav="portal/people/person/{{ item._actor.person_id }}/view">{{ item._actor.name }}</strong>
            <span data-nav="portal/people/person/{{ item._actor.person_id }}/view" class="activity-username">@{{ item._actor.username }}</span>

            <span class="time">{{ item.timeago_format }}</span>
        </div>

        <div class="comment-text">
            {{ item.body }}
        </div>

    </div>
</div>