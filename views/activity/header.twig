{% set actor = item.actor %}
{% set avatar = actor.avatar ?? 'assets/images/icons/noavatar.png' %}
{% set name = actor.name ?? 'Unknown' %}
{% set username = actor.username ? '@' ~ actor.username : '' %}

<div class="activity-header">
    <img class="activity-avatar lazy" src="{{ avatar|default('assets/images/icons/noavatar.png') }}" alt="">
    <div class="activity-header-meta">
        <div class="activity-author">
            <a data-nav="portal/people/person/{{ actor.person_id }}/view">
                {{ name }}
            </a>
            <span class="activity-username">{{ username }}</span>
        </div>
        <div class="activity-time">{{ item.timeago_format }}</div>

        {% if hasPermission('activity','contextMenu', true) %}
        <button
            data-context-trigger
            data-context-type="activity"
            data-context-id="{{item.id}}"
            >
            ⋮
        </button>
        {% endif %}

    </div>
</div>
