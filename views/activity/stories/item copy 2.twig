{% set first = group|first %}
{% set count = group|length %}

<div
    class="story-card"
    data-action="story.open"
    data-actor="{{ first.actor_id }}"
>

    <div class="story-thumb">

        <img
            src="{{ first.payload.preview }}"
            alt=""
        >

        <div class="story-overlay"></div>

        {% if count > 1 %}
            <div class="story-count">
                {{ count }}
            </div>
        {% endif %}

        <div class="story-user">

            <img
                class="story-user-avatar" data-action="inbox:view_profile" data-id="{{ first.actor_id }}" data-type="user"
                src="{{ first.actor.avatar_url ?? '' }}"
            >

            <div class="story-user-meta">

                <div class="story-username" data-action="inbox:view_profile" data-id="{{ first.actor_id }}" data-type="user">
                    {{ first.actor.username ?? 'User' }}
                </div>

            </div>

        </div>

    </div>

</div>