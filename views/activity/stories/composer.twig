<div class="story-composer">

    <div class="composer-header">
        
    </div>

    <div class="composer-preview" id="storyPreview">
        <div class="story-placeholder">
            <span>Tap to add story</span>
        </div>
    </div>

    <input type="file"
           id="storyUpload"
           name="newimage"
           accept="image/*,video/*"
           hidden
           required
           >

    <textarea name="body"
              class="story-caption"
              placeholder="Add a caption (optional)" required></textarea>

</div>

<script>
$(function(){
    let file = null;
    let bound = false;

    function bindUI(){
        if(bound) return;

        $(document).on('click', '#storyPreview', openFileDialog);
        $(document).on('change', '#storyUpload', handleFile);

        bound = true;
    }

    function openFileDialog(){
        $('#storyUpload').click();
    }

    function handleFile(e){
        const f = e.target.files[0];
        if(!f) return;

        file = f;

        renderPreview(f);
    }

    function renderPreview(file){

        const url = URL.createObjectURL(file);
        let html = '';

        if(file.type.startsWith('image')){
            html = `<img src="${url}" class="story-preview-media">`;
        }

        if(file.type.startsWith('video')){
            html = `<video src="${url}" class="story-preview-media" autoplay muted loop></video>`;
        }

        $('#storyPreview').html(html);
    }

    bindUI();
});
</script>