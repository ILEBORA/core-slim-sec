<div
    class="story-viewer"
    data-actor="{{ actorId }}"
>

    <div class="story-header">

        <div class="story-progress-wrap"></div>

        <div class="story-user">

            <img
                src=""
                class="story-avatar" data-action="inbox:view_profile" data-id="{{ actor_id }}" data-type="user"
            >

            <div class="story-meta">

                <div class="story-username" data-action="inbox:view_profile" data-id="{{ actor_id }}" data-type="user"></div>

                <div class="story-time"></div>

            </div>

        </div>

        <button
            class="story-close"
            data-action="popup.close"
        >
            ×
        </button>

    </div>

    <div class="story-content">

        <img
            class="story-image"
            src=""
            alt=""
        >

        <video
            class="story-video"
            playsinline
            webkit-playsinline
        ></video>

        <div class="story-text"></div>

        <div
            class="story-nav prev"
            data-action="story.prev"
        ></div>

        <div
            class="story-nav next"
            data-action="story.next"
        ></div>

    </div>

    <div class="story-actions">

        <input
            type="text"
            class="story-reply"
            placeholder="{{ __t(
                'activity.placeholder.reply',
                null,
                'Reply'
            ) }}"
        >

        <button class="story-send">

            {{ __t(
                'activity.label.send',
                null,
                'Send'
            ) }}

        </button>

    </div>

</div>