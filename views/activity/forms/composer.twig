<div class="activity-composer">

    <div class="composer-header">
        
    </div>

    <div class="composer-preview" id="composerPreview"></div>

    <input type="file"
           id="composerUpload"
           accept="image/*,video/*"
           multiple
           hidden
           >

    <div class="composer-tools">

        <button type="button" class="attach-photo">
            📷 Photo or 🎥 Short Video
        </button>

        <button type="button" class="attach-video" hidden>
            🎥 Short Video
        </button>

        <button type="button" class="attach-link hide">
            🔗 Link
        </button>

    </div>

</div>