<div class="share-sheet">

        <div class="share-sheet-title">
            Share
        </div>

        <div class="share-actions">

            <button class="share-btn" data-action="activity.share.timeline" data-id="{{ id }}">

                <i class="fa fa-retweet"></i>
                <span>Timeline</span>

            </button>

            <button class="share-btn" data-action="activity.share.copylink" data-url="{{ url }}">

                <i class="fa fa-link"></i>
                <span>Copy Link</span>

            </button>

            <button class="share-btn" data-action="activity.share.whatsapp" data-url="{{ url }}">

                <i class="fab fa-whatsapp"></i>
                <span>WhatsApp</span>

            </button>

            <button class="share-btn" data-action="activity.share.telegram" data-url="{{ url }}">

                <i class="fab fa-telegram"></i>
                <span>Telegram</span>

            </button>

        </div>

    </div>