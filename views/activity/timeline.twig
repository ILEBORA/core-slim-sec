{# Timeline Wrapper #}
<div class="timeline">
    {{lvui|raw}}
    {# Composer placeholder (future use) #}
    <div class="timeline-composer">
        <div class="composer-placeholder">
            What’s on your mind?
        </div>
    </div>

    {# Feed #}
    <div
        id="activityFeedNew"
        class="timeline-feed activityFeedNew"
        data-scope="{{ scope|default('home') }}"
    >
        {% for entry in items %}
            {{ entry.html|raw }}
        {% endfor %}
    </div>

    {# Loading indicator #}
    <div class="timeline-loading" style="display:none;">
        Loading…
    </div>

</div>
