{# Timeline Wrapper #}
<div class="timeline">
    {{lvui|raw}}

     {# Stories #}
    {% include 'activity/stories.twig' %}

    {# Composer placeholder (future use) #}
    <div class="timeline-composer">
        <div class="composer-placeholder" data-action="act-timeline-composer">
            {{ __t('activity.placeholder.whats_on_your_mind', null, 'What’s on your mind?') }}
        </div>
    </div>

    {# Feed #}
    <nav class="activity-tabs">
        <button data-tab="foryou" class="active">For You</button>
        <button data-tab="following">Following</button>
    </nav>  

    <div class="activity-content">

        <div class="activity-tab-panel active" data-tab="foryou">
            <div class="tab-placeholder"
                 data-tab="foryou">
                <!-- will be replaced -->
                {% include 'activity/timeline/tabs/foryou.twig' with{ data: data }%}
            </div>
        </div>

        <div class="activity-tab-panel" data-tab="following">
            <div class="tab-placeholder"
                 data-tab="connections">
                <!-- will be replaced -->
                Following...
            </div>
        </div>

    </div>


    

</div>
