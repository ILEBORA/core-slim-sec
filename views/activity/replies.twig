<div class="activity-thread" data-id="{{ itemId }}" data-parent="{{parent_id}}">

    {# Activity summary (hydrated via JS) #}
    <button>{{ __t('activity.label.go_back', null, 'Go Back') }}</button>
    <div id="threadActivity" class="activity-entry"><center><img src="assets/images/icons/ajax.gif"/></center></div>

    {# Comment composer #}
    <div class="thread-composer">
        <input type="text" name="parent_id" value="{{ parent_id }}"/>
        <textarea
            id="threadCommentBody"
            class="input-placeholder"
            placeholder="{{ __t('activity.placeholder.write_reply', null, 'Post your reply') }}"></textarea>

        <button id="thread.send.comment" class="btn btn-success space_left">
            {{ __t('activity.label.reply', null, 'Reply') }}
        </button>
    </div>

    {# Comments list #}
    <div id="threadComments" class="thread-comments"><center><img src="assets/images/icons/ajax.gif"/></center></div>

</div>

<script>
$(function(){
    Thread.init(false);
    const ctx = window.__diagContext || {};

    if (ctx.state?.focus === 'composer') {
        $('#threadCommentBody').focus();
    }
})
</script>