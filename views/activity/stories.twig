<div id="storiesRail" class="stories-rail">

    {% if canCreate %}
        <div
            class="story-card story-create"
            data-action="story.create"
        >

            <div class="story-create-inner">

                <div class="story-create-icon">+</div>

                <div class="story-create-label">
                    Create Update
                </div>

            </div>

        </div>
    {% endif %}

    <div id="storiesContainer" class="stories-container">

        {% for group in stories %}
            {% include 'activity/stories/item.twig' with {
                group: group
            } %}
        {% endfor %}

    </div>

</div>