{# Stories Rail #}
<div id="storiesRail" class="stories-rail">

    {# Create Story #}
    {% if canCreate %}
    <div class="story-item story-create" id="createStoryBtn">
        <div class="story-avatar">
            <span class="plus">+</span>
        </div>
        <div class="story-label">Your Story</div>
    </div>
    {% endif %}

    {# Stories injected here by JS #}
    <div id="storiesContainer" class="stories-container"></div>

</div>