{% set count = item.media|length %}
{% if count > 0 %}
<div class="activity-media">

    {% if count <= 4 %}
        <div class="media-grid grid-{{count}}">
            {% for media in item.media %}
                <img src="{{ media.preview_path }}">
            {% endfor %}
        </div>
    {% else %}
        <div class="media-carousel swiper">
            <div class="swiper-wrapper">
                {% for media in item.media %}
                <div class="swiper-slide">
                    <img src="{{ media.preview_path }}">
                </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

</div>
{% endif %}